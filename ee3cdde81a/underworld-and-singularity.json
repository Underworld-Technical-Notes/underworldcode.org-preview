Help/pages/236881323/What+is+Gadi+...","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"NCI","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"SYydtFwEso"}],"urlSource":"https://opus.nci.org.au/spaces/Help/pages/236881323/What+is+Gadi+...","key":"rrKbEtZroB"},{"type":"text","value":") and Setonix (","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"yu9jEhYM03"},{"type":"link","url":"https://pawsey.atlassian.net/wiki/spaces/US/pages/51925434/Setonix+User+Guide","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Pawsey","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"bkxi3yL4HU"}],"urlSource":"https://pawsey.atlassian.net/wiki/spaces/US/pages/51925434/Setonix+User+Guide","key":"SQOHyuNlAy"},{"type":"text","value":"). The benefits of containerisation outweigh the negatives, and in this post we highlight this and present the new setup for running Underworld2 on Gadi and Setonix.","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"l6LsjLiXkp"}],"key":"uxwkJnCVzl"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Fig 1.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"B7kymOYyq9"}],"key":"Rp8mDrE3HP"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/ee3cdde81a/build/data-src-image-162f5-c10c2bbf0572169c3e33a587648f7509.png","alt":"Weak scaling measures parallel efficiency. Increasing cpu number on the horizontal axis and runtime on the vertical axis.","data":{"altTextIsAutoGenerated":true},"key":"CPZ1P5njlh","urlSource":"figures/data-src-image-162f5c11-fa50-4e21-a1d0-ff8bca639dcd.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"Weak scaling measures parallel efficiency. Increasing cpu number on the horizontal axis and runtime on the vertical axis.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"qO5emrhvXk"}],"key":"fLyueuANfo"}],"key":"l7ziKt06Nv"}],"enumerator":"2","key":"prrowdOeDT"},{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"Fig 1. is a weak scaling plot, where a model with constant work per CPU is timed on increased numbers of CPUS (1 to 10,648). The horizontal axis represents CPU counts and the vertical axis represents total run time.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"rwbc2e8u8P"},{"type":"break","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"miipBFaya2"},{"type":"text","value":"Weak scaling measures parallel communication efficiency of computation, a horizontal plot indicate an algorithm that scales perfectly with more CPU (with computation per CPU kept constant on communication overheads should cause it to increase in time).","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"hKUuraS0T0"},{"type":"break","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"baRi0Yktd8"},{"type":"text","value":"The model used in this case runs all of Underworld’s significant algorithms, the most costly of which is solving the stokes equation (the green graph).","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"gS1m948UtS"},{"type":"break","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"oy9h1m1HAY"},{"type":"text","value":"From the plots we find the execution of singularity (solid lines) is slightly more efficient than the tradition /  bare metal installs of Underworld 2.16. The significant difference are seen in the Python_Import_Time, yellow line, which, to be clear, is not a part of the Total_Runtime.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"qnouTNlygR"},{"type":"break","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"MhEpa5ySWH"},{"type":"text","value":"This is an encouraging result. Overall parallel efficiency with singularity is no less performant than the bare metal install and the Underworld python package import time, a startup costs, sees significant improvement.","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"uDgbKesD6q"}],"key":"PctOclgn1t"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"This results, along with the simplified workflow of using singularity images makes it a clear best practice for running Underworld models on HPC platforms.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"Hcf03u4TWR"},{"type":"break","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"lzb4ykseET"},{"type":"text","value":"Below we showcase how to run Underworld2 with Singularity on Gadi or Setonix.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"kVGdvKPBWl"}],"key":"JmNYySCEDu"},{"type":"thematicBreak","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"xdFRi3KUt4"},{"type":"heading","depth":2,"position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Key Ingredients for a Singularity Build:","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"Ufmo1DdFaK"}],"identifier":"key-ingredients-for-a-singularity-build","label":"Key Ingredients for a Singularity Build:","html_id":"key-ingredients-for-a-singularity-build","implicit":true,"key":"NYMLZXOg5N"},{"type":"paragraph","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"(Developer notes)","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"hBtzCpctgo"}],"key":"CFHhFCBlPs"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"For container creation, Dockerfile considerations.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"wicuG7CeIE"}],"key":"y3XmJ2U4xY"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":84,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"ABI-Compatible MPI Implementation: Your container must be built with an ABI-compatible MPI implementation for the HPC machine. For Gadi, use OpenMPI; for Setonix, use MPICH.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"zdMW4UzTuq"}],"key":"tM3LUyUzwY"}],"key":"MbYZsvWtwh"},{"type":"listItem","spread":true,"position":{"start":{"line":86,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"Bind Mounts and Path Variables: Proper bind mounts and path variables must be set for HPC machine MPI utilization. Different HPC systems automate these setups individually, so care must be taken. Hence the different commands in the ","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"IC8PhCAfHO"},{"type":"link","url":"http://runner.sh","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"runner.sh","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"UG