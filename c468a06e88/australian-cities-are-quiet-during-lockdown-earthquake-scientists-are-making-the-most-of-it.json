national","free":true,"CC":true}},"open_access":true,"github":"https://github.com/underworld-technical-notes/underworldcode.org","numbering":{"title":{"offset":2}},"source_url":"https://github.com/underworld-technical-notes/underworldcode.org/blob/main/articles/australian-cities-are-quiet-during-lockdown-earthquake-scientists-are-making-the-most-of-it/australian-cities-are-quiet-during-lockdown-earthquake-scientists-are-making-the-most-of-it.md","edit_url":"https://github.com/underworld-technical-notes/underworldcode.org/edit/main/articles/australian-cities-are-quiet-during-lockdown-earthquake-scientists-are-making-the-most-of-it/australian-cities-are-quiet-during-lockdown-earthquake-scientists-are-making-the-most-of-it.md","thumbnail":"/underworldcode.org-preview/c468a06e88/build/banner-aac5929f2aaee7c5768a9053197115ba.png","exports":[{"format":"md","filename":"australian-cities-are-quiet-during-lockdown-earthquake-scientists-are-making-the-most-of-it.md","url":"/underworldcode.org-preview/c468a06e88/build/australian-cities-ar-29b9a8eebe3a81b9f5f3f78b39b9a293.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"div","class":"uwtn-banner","children":[{"type":"image","url":"/underworldcode.org-preview/c468a06e88/build/banner-aac5929f2aaee7c5768a9053197115ba.png","key":"LTE48dVQvF","urlSource":"figures/banner.png"}],"key":"Sk9GUhCraG"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"link","url":"https://theconversation.com/profiles/meghan-s-miller-1105475","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Meghan S. Miller","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"u9NDrDsDXR"}],"urlSource":"https://theconversation.com/profiles/meghan-s-miller-1105475","key":"Fmhg7wjSV0"},{"type":"text","value":", ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"YxJiCZXXwg"},{"type":"emphasis","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"link","url":"https://theconversation.com/institutions/australian-national-university-877","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Australian National University","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"FyYt1xyBRp"}],"urlSource":"https://theconversation.com/institutions/australian-national-university-877","key":"RdMy8yJkKw"}],"key":"stadIyIQtG"},{"type":"text","value":" and ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"u72kxeLugh"},{"type":"link","url":"https://theconversation.com/profiles/louis-moresi-1133314","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Louis Moresi","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"aa7K4BqPyC"}],"urlSource":"https://theconversation.com/profiles/louis-moresi-1133314","key":"G3w5G5qHF8"},{"type":"text","value":", ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"yQe1qj3BPD"},{"type":"emphasis","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"link","url":"https://theconversation.com/institutions/australian-national-university-877","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Australian National University","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"i8tj1dmkEB"}],"urlSource":"https://theconversation.com/institutions/australian-national-university-877","key":"NRVSb6k0G6"}],"key":"bHteJQ21jQ"}],"key":"MVmYCMtoMs"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Our responses to the COVID-19 pandemic have dramatically changed human activity all over the world. People are working from home, schools are closed in many places, travel is restricted, and in some cases only essential shops and businesses are open.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"HgWr5WNrMA"}],"key":"aVXjKbZycp"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Scientists see signs of these changes wherever they look. Carbon dioxide emissions are down, air quality has improved, and there is less traffic.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"d2sXCuvhzs"}],"key":"pL3NGzt65y"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"The drop in activity has also been a surprising boon for earthquake scientists like us. Our sensitive instruments are detecting far less of the noise and vibration produced by humans in motion — which means we have a unique opportunity to listen in on tiny earthquakes we might never have detected otherwise.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"nw2ByHdLIF"}],"key":"YEVTv5tDFt"},{"type":"thematicBreak","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"DyuNkqjd9M"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":31,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"**\nRead more:\n","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"kUg0TK8HVl"},{"type":"link","url":"https://theconversation.com/underground-sounds-why-we-should-listen-to-earthquakes-5798","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Underground sounds: why we should listen to earthquakes","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"slp0ulEEjM"}],"urlSource":"https://theconversation.com/underground-sounds-why-we-should-listen-to-earthquakes-5798","key":"NxohuUVwoN"},{"type":"text","value":"\n**","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"oc4BkeewVN"}],"key":"ygxub71aKH"}],"key":"uoGanHzQSQ"},{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":37,"column":1}},"children":[],"key":"biCqH5Qdis"}],"key":"xjqz0i8L1S"},{"type":"thematicBreak","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"mPBdfMr2iN"},{"type":"heading","depth":2,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"The seismic hum of humans","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"JnYCsUp3WN"}],"identifier":"the-seismic-hum-of-humans","label":"The seismic hum of humans","html_id":"the-seismic-hum-of-humans","implicit":true,"key":"MJWP6kAa2N"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Seismometers are sensitive scientific instruments used to detect earthquakes, volcanic eruptions and nuclear tests, by recording the movement of the ground. They often detect mining activity and can even pick out crowds responding to football games — so-called “footyquakes”.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"Ver3tY3v7i"}],"key":"FtI4SSSzYB"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"On top of this, everyday human activity creates a high-frequency seismic “hum” that is stronger during the day and weaker at night. This is particularly evident in urban environments, but is also observed in rural or unpopulated areas.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"x3ja5qgcpl"}],"key":"MWq1NQszlR"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"The decrease in this noise signature was first identified in March by Belgian  scientists as lockdown measures were introduced in Europe. These early results, computer codes and data were widely shared on Twitter, sparking an enthusiastic collaboration of seismologists around the world who found this change in signal everywhere they looked.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"NBC752ZLDm"}],"key":"Vp9LNHwocB"},{"type":"heading","depth":2,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Schoolyard sounds","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"SnSeil4cXC"}],"identifier":"schoolyard-sounds","label":"Schoolyard sounds","html_id":"schoolyard-sounds","implicit":true,"key":"bSxx0r7BcX"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"In Australia, the change in human behaviour was most dramatically observed in the data recorded by the ","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"CbO7RX7PZ2"},{"type":"link","url":"http://ausis.edu.au/","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Australian Seismometers in Schools (AuSiS) network","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"llFybxViHi"}],"urlSource":"http://ausis.edu.au/","key":"AcTtKYVpyd"},{"type":"text","value":". These instruments are research-quality seismometers that are maintained by school students — our next generation of geophysicists.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"obEFbOmuTI"}],"key":"BWdsXEdSrW"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"The usual happy schoolyard sounds and hubbub disappeared at many schools, as they shut and most or all students stayed home. The usual hum of the children (and teachers) during the school day, observed in the movement between classrooms, and during lunchtimes or Saturday morning sports, abruptly stopped at locations such as Ulladulla High School on the south coast of New South Wales and Keysborough Secondary College in suburban Melbourne.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"Jv39bgQHkz"}],"key":"Q1rqlCQKsO"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/c468a06e88/build/file-20200716-17-1xk-cb5cf2d336f251f17d10244013d0a86e.png","alt":"The heartbeat of four schools from December 1 2019 to July 15 2020. The summer holiday and the school closedown period are eerily quiet. AuSiS, Author provided","data":{"altTextIsAutoGenerated":true},"key":"oLsTVCTW0W","urlSource":"figures/file-20200716-17-1xkxswe.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"The heartbeat of four schools from December 1 2019 to July 15 2020. The summer holiday and the school closedown period are eerily quiet. AuSiS, Author provided","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"lSbaOKxEX4"}],"key":"U60jgNCghQ"}],"key":"XwGVBZPAo4"}],"enumerator":"1","key":"fMfYeIIOu9"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"At other schools, such as Daramalan College in Canberra, there was only a small decrease in human noise, with the school seismometer recording people commuting to work in essential public services and government offices that continued to operate throughout the initial lockdown. The seismometer at North Rockhampton State High School in Queensland also saw less of the effect, as the students were still able to attend classes.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"FDxrq8pmTn"}],"key":"dEUFf9XHoG"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"The level of noise recorded across Australia during lockdown compares to the Christmas week. When restrictions began easing, the signal was similar to the annual January pattern when schools are closed, most businesses are open but many people are away on holiday. As schools reopened across Australia in mid to late May, noise levels were mostly back to “normal” except for what is usually observed for Saturday morning sports.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"tZk7tCXsEc"}],"key":"coY64HETLw"},{"type":"heading","depth":2,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Lockdown 2.0","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"wkJh5l1jVJ"}],"identifier":"lockdown-2-0","label":"Lockdown 2.0","html_id":"lockdown-2-0","implicit":true,"key":"Fulj11AmFi"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/c468a06e88/build/file-20200715-31-1f0-658244185c8dc5f58092790a32ad6fce.png","alt":"At Keysborough Secondary College in Victoria, school hours, especially between lessons, are bustling and noisy. Weekends and night-times are quiet enough to use these instruments for seismological research. AuSiS, Author provided","data":{"altTextIsAutoGenerated":true},"key":"icLhDbLYff","urlSource":"figures/file-20200715-31-1f0ixal.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"At Keysborough Secondary College in Victoria, school hours, especially between lessons, are bustling and noisy. Weekends and night-times are quiet enough to use these instruments for seismological research. AuSiS, Author provided","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"tQZ7hrrnoF"}],"key":"LAYlAP7JmU"}],"key":"ULQSPWZQC8"}],"enumerator":"2","key":"T4jpjS7E6T"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"However, regional differences became even more pronounced as metropolitan Melbourne reinstated stay-at-home restrictions on July 8. As a second spike of COVID-19 cases was detected in Victoria and then ramped up in late June, the level of movement began to drop again.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"Y1xzSPmxGN"}],"key":"Agu2cAg2hE"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"In the seismic noise signal from Keysborough Secondary College, we can see the school holiday quiet period becoming quieter still as further restrictions to school activity were enforced.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"tGTdrSjqJo"}],"key":"rW7O0vVe6Z"},{"type":"thematicBreak","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"KQWjPioKXm"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":76,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":76,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"**\nRead more:\n","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"jZFkx4eaHa"},{"type":"link","url":"https://theconversation.com/the-victorian-earthquake-didnt-do-much-damage-but-the-next-one-might-7787","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"The Victorian earthquake didn’t do much damage ... but the next one might","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"IW0n0QWCVq"}],"urlSource":"https://theconversation.com/the-victorian-earthquake-didnt-do-much-damage-but-the-next-one-might-7787","key":"NyzDNApUnb"},{"type":"text","value":"\n**","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"PQjsNI6P2z"}],"key":"MbxcdHi2te"}],"key":"RQwPeptMV8"},{"type":"listItem","spread":true,"position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[],"key":"jMd9EauBjX"}],"key":"X9PS55POTE"},{"type":"thematicBreak","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"STel2i9rSu"},{"type":"heading","depth":2,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Earthquake detection","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"gE62Y2p2FN"}],"identifier":"earthquake-detection","label":"Earthquake detection","html_id":"earthquake-detection","implicit":true,"key":"lf9E18sT5t"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"The low level of background noise from humans recorded in the seismic data during lockdown gives us a window of opportunity to study smaller earthquakes. Detection of small earthquakes or motion on fault lines is essential for seismic hazard assessment.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"lBjAe37jSG"}],"key":"LWegWb94Gs"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"Small events are typically identified by looking at changes in amplitudes of signals, but very small events have small amplitude signals and these cannot be observed because they are drowned out by the background noise.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"RW9ExOMYif"}],"key":"fEtneoOzZL"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"This time of quiescence in seismic noise due to the COVID-19 emergency provides a unique opportunity to learn more about small earthquakes occurring in previously unidentified locations.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"gj9nOcGp6S"},{"type":"image","url":"/underworldcode.org-preview/c468a06e88/build/count-3867e633d17322e4add4f00008f129ae.gif","alt":"The Conversation","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"Q1kPWEttgO","urlSource":"figures/count.gif"}],"key":"pdjKChcElJ"},{"type":"paragraph","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"link","url":"https://theconversation.com/profiles/meghan-s-miller-1105475","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Meghan S. Miller","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"nnqbgitSWg"}],"urlSource":"https://theconversation.com/profiles/meghan-s-miller-1105475","key":"xaYV7Ud6q8"},{"type":"text","value":", Associate Professor; Program Director AuScope Earth Imaging, ","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"cNEZbkR91D"},{"type":"emphasis","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"link","url":"https://theconversation.com/institutions/australian-national-university-877","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Australian National University","position