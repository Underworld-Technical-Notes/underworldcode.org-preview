:{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"XKuK0sRPpx"}],"key":"WRnNK45QKc"}],"key":"EfKlejVnaE"}],"key":"tcZTDrkYia"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/c468a06e88/build/kaus2010RTI-eae3252961a967dde5fd59e7e45fbdfb.gif","key":"p6VhdbWSGq","urlSource":"figures/kaus2010RTI.gif"}],"enumerator":"2","key":"MoE2GxJeYx"},{"type":"heading","depth":2,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Limitations and stabllization methods","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"s9ZsSO7QjQ"}],"identifier":"limitations-and-stabllization-methods","label":"Limitations and stabllization methods","html_id":"limitations-and-stabllization-methods","implicit":true,"key":"IhU4YU3GI1"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"All of the approaches to free surface simulations have been subject to instability which has been variously termed a “sloshing instability” or the “drunken sailor effect” (Kaus et al., 2010). This instability, arising from the large density contrast typical at a free surface (the rock-air interface in the “sticky air” method), severely limits the maximum stable timestep for computations. Frequently, the maximum stable timestep is several orders of magnitude smaller than that for an equivalent model with free-slip boundary conditions. Stabilization methods (like FSSA from Kaus et al, (2010)) would be needed to solve that, while that’s another story.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"NmSnHwK6ku"}],"key":"ue8FIGUi2I"},{"type":"image","url":"/underworldcode.org-preview/c468a06e88/build/F_ToBeContinued-0d6117170433caae50f7ec2968134cf2.png","width":"200px","align":"center","key":"Nne2tLYXGK","urlSource":"figures/F_ToBeContinued.png"},{"type":"heading","depth":2,"position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"References","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"QwtjMbmzQe"}],"identifier":"references","label":"References","html_id":"references","implicit":true,"key":"O6gYOrdiiJ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":80,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":80,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Crameri, F., Schmeling, H., Golabek, G. J., Duretz, T., Orendt, R., Buiter, S. J. H., ... & Tackley, P. J. (2012). A comparison of numerical surface topography calculations in geodynamic modelling: an evaluation of the ‘sticky air’method. Geophysical Journal International, 189(1), 38-54.","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"wcTEE6NnrD"}],"key":"pzu3utkVDM"}],"key":"QfUSFdImD9"},{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Kaus, B. J., Mühlhaus, H., & May, D. A. (2010). A stabilization algorithm for geodynamic numerical simulations with a free surface. Physics of the Earth and Planetary Interiors, 181(1-2), 12-20.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"THbRDqoOGt"}],"key":"qeFaBIZAxL"}],"key":"IvrddedJdP"},{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Schmeling, H., Babeyko, A. Y., Enns, A., Faccenna, C., Funiciello, F., Gerya, T., ... & Van Hunen, J. (2008). A benchmark comparison of spontaneous subduction models—Towards a free surface. Physics of the Earth and Planetary Interiors, 171(1-4), 198-223.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"KnYpeTPDGq"}],"key":"necCsdZbDb"}],"key":"ZSn7PLzVG1"}],"key":"l66k67yh4i"},{"type":"div","class":"uwtn-discuss","children":[{"type":"div","class":"uwtn-discuss-head","children":[{"type":"text","value":"Comments","key":"idPCI7b9o1"}],"key":"mRxIjdoC0n"},{"type":"div","class":"uwtn-discuss-body","children":[{"type":"text","value":"Discussion of these notes happens in GitHub Discussions, so it stays with the source and is searchable alongside it.","key":"iwvaqpBUHw"}],"key":"Tn7u548qsR"},{"type":"div","class":"uwtn-discuss-links","children":[{"type":"link","url":"https://github.com/Underworld-Technical-Notes/underworldcode.org/discussions?discussions_q=free-surface-in-underworld","children":[{"type":"text","value":"Read the discussion","key":"N1OShWkzT8"}],"urlSource":"https://github.com/Underworld-Technical-Notes/underworldcode.org/discussions?discussions_q=free-surface-in-underworld","error":true,"key":"Zz5Lp2l6k9"},{"type":"link","url":"https://github.com/Underworld-Technical-Notes/underworldcode.org/discussions/new?category=general&title=free-surface-in-underworld","children":[{"type":"text","value":"Start one","key":"yRoOyxzt4u"}],"urlSource":"https://github.com/Underworld-Technical-Notes/underworldcode.org/discussions/new?category=general&title=free-surface-in-underworld","error":true,"key":"e4xQp1HtM2"}],"key":"MOcNt28UgD"}],"key":"SnGHoIXRfM"}],"key":"D1iicnUM0A"}],"key":"LScHOKHTsE"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"ISMIP-HOM benchmark experiments using Underworld","url":"/ismip-hom-benchmark-experiments-using-underworld","group":"2023"},"next":{"title":"Underworld 2.11 Scaling","url":"/2-11-scaling","group":"2021"}}