e3hHS"},{"type":"link","url":"https://unsplash.com/?utm_source=underworld-technical-notes&utm_medium=referral&utm_campaign=api-credit","children":[{"type":"text","value":"Unsplash","key":"g7ncaC0q96"}],"urlSource":"https://unsplash.com/?utm_source=underworld-technical-notes&utm_medium=referral&utm_campaign=api-credit","key":"lQpFawEqfS"}],"key":"i2q8J9VclR"}],"key":"DUmKlXW9z8"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"In Underworld2, the answer was context managers. You would wrap every data access in a ","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"lnO0u1zX7M"},{"type":"inlineCode","value":"with","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"kRidLPxFl1"},{"type":"text","value":" block, and the framework synchronised the arrays on exit. It was safe, but verbose.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"FINrIv8Cj6"}],"key":"CA5dJY6c10"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"In Underworld3, you just write to the array. The synchronisation happens automatically.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"KdReP6Ph2u"}],"key":"jMxsy51C8e"},{"type":"code","lang":"python","value":"# Underworld2 (old)\nwith mesh.access(temperature):\n    temperature.data[...] = values\n\n# Underworld3 (current)\ntemperature.data[...] = values","position":{"start":{"line":35,"column":1},"end":{"line":42,"column":1}},"key":"bOhl4GBd13"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"This post explains how we make that work.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"llr4odiX4d"}],"key":"iFzEj1ljHR"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"The Problem","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"anKQ0J45yg"}],"identifier":"the-problem","label":"The Problem","html_id":"the-problem","implicit":true,"key":"Hwp6lNriq8"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"PETSc stores field data in distributed vectors. Each MPI rank owns a portion of the mesh and holds a ","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"znaGjGRnvD"},{"type":"emphasis","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"local vector","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"feDl5VUT84"}],"key":"ED0RxP5EwO"},{"type":"text","value":" (","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"R1WO2PDI5r"},{"type":"inlineCode","value":"_lvec","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"BnLucyXpnf"},{"type":"text","value":") that includes ghost values from neighbouring ranks. The solver reads and writes these local vectors during assembly and solution.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"w8azfFy14v"}],"key":"Ugc0XxQJKQ"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"The user wants to work with NumPy arrays. They want to set initial conditions, apply corrections, read solution values — all using familiar NumPy indexing. They do not want to know about local vectors, global vectors, ghost regions, or scatter operations.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"uERwtK6MWv"}],"key":"xbeIuUeWbn"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"The challenge is bridging these two worlds without introducing bugs. If the user modifies an array but PETSc doesn’t see the change, the solver works with stale data. If PETSc rebuilds its internal data structures (because the mesh adapted or a new variable was added), the user’s cached array view points at freed memory.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"HU8LLhBcuT"}],"key":"DiXWrIuzgJ"},{"type":"heading","depth":2,"position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"NDArray_With_Callback: A Reactive NumPy Array","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"uVIcaZM5qX"}],"identifier":"ndarray-with-callback-a-reactive-numpy-array","label":"NDArray_With_Callback: A Reactive NumPy Array","html_id":"ndarray-with-callback-a-reactive-numpy-array","implicit":true,"key":"q2ilPX1XtX"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"The core mechanism is ","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"mS5zHnWRn4"},{"type":"inlineCode","value":"NDArray_With_Callback","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"UiWxV1Ajrr"},{"type":"text","value":" — a NumPy ndarray subclass that fires a callback whenever its data is modified. When you write ","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"bLdLtJBg0O"},{"type":"inlineCode","value":"temperature.data[0:10] = 300.0","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"m3huMblTUT"},{"type":"text","value":", the array detects the assignment and triggers a synchronisation callback that copies the modified values into the PETSc local vector and scatters them to neighbouring ranks.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"oA6totUXx4"}],"key":"EUNcxbxr5F"},{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"The user sees a NumPy array. Behind it, every write triggers:","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"V0nN5DCYsu"}],"key":"YjBDAn8JcS"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":60,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":60,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Values are written into the PETSc local vector","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"KVOuAMNAU5"}],"key":"y0NY4zBAEd"}],"key":"WEuNc5WKnG"},{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"A local-to-global scatter copies owned values to the global vector","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"NRINLKeyQG"}],"key":"w3nkGWsF9p"}],"key":"PMUSvar502"},{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"A global-to-local scatter fills ghost regions from neighbouring ranks","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"Qz7ET0YjoF"}],"key":"uomZ3jv0Rh"}],"key":"MPmR7lfnnH"}],"key":"bWuyhm5XRD"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"After step 3, every rank has consistent data including ghost values. The solver can proceed safely.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"V3cMPVRx7Y"}],"key":"SeqcqvAcvk"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/c468a06e88/build/arrays-sync-flow-4f5224422a2011735ea6e8c88991865e.svg","alt":"The data synchronisation pipeline: a write to .data or .array triggers a callback that packs values into the PETSc local vector, scatters to the global vector, and fills ghost regions from neighbouring MPI ranks.","data":{"altTextIsAutoGenerated":true},"key":"HOSDcHeswt","urlSource":"figures/arrays-sync-flow.svg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"The data synchronisation pipeline: a write to .data or .array triggers a callback that packs values into the PETSc local vector, scatters to the global vector, and fills ghost regions from neighbouring MPI ranks.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"z6xmz8OLde"}],"key":"PiffCV1Lc9"}],"key":"e8lwI1vEKA"}],"enumerator":"1","key":"Q8QcaQznTB"},{"type":"heading","depth":2,"position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"The Self-Validating Cache","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"ofM20VaemR"}],"identifier":"the-self-validating-cache","label":"The Self-Validating Cache","html_id":"the-self-validating-cache","implicit":true,"key":"IrdfG6Ti6V"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"z95MSxEV3f"},{"type":"inlineCode","value":".data","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"YwULD4c8fI"},{"type":"text","value":" property on a MeshVariable returns an ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"aBzfM57vvl"},{"type":"inlineCode","value":"NDArray_With_Callback","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"tCIjDxsaAf"},{"type":"text","value":" view into the PETSc local vector. Creating this view is not free — it involves extracting the raw pointer from PETSc, wrapping it in NumPy, registering callbacks, and reshaping. So the variable caches it.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"voPVACsF0K"}],"key":"b6Ll38yKgQ"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"The danger is stale caches. PETSc can destroy and recreate its internal vectors when:","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"cymHBgiqPg"}],"key":"KHly2Bd7iv"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":79,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":79,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"A new MeshVariable is added to the mesh (triggers a DM rebuild)","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"S0SZ3a0BTO"}],"key":"mfZe0GaIh9"}],"key":"BDqUhdeZ86"},{"type":"listItem","spread":true,"position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"The mesh adapts (new topology, new vectors)","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"XO5Bryvm1E"}],"key":"hh6m8ix1VO"}],"key":"AoIyAWcn9r"}],"key":"bPy58yaB0Y"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"After either event, the old cached array view points at deallocated memory. Reading it returns garbage; writing to it corrupts the heap.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"FmsSJ5xjaX"}],"key":"uTxk1FAnXl"},{"type":"paragraph","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"UW3 solves this with a single line of defence: on every ","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"GdPzSIqBF9"},{"type":"inlineCode","value":".data","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"kYdwQlb3u9"},{"type":"text","value":" or ","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"kkxIrxn0iX"},{"type":"inlineCode","value":".array","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"fRLQ5oECMG"},{"type":"text","value":" access, it checks whether ","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"uvN19nS7JU"},{"type":"inlineCode","value":"id(self._lvec)","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"HZCPgItov7"},{"type":"text","value":" matches the cached value. Python’s ","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"USKpOc0gcV"},{"type":"inlineCode","value":"id()","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"wYRkkXV65e"},{"type":"text","value":" returns the memory address of an object. If PETSc has replaced the local vector, the new object has a different ","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"LyaDhlVxuM"},{"type":"inlineCode","value":"id","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"cgKcQ0yC2S"},{"type":"text","value":", the check fails, and the cache rebuilds automatically.","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"c9u1O2Qhmv"}],"key":"UhHBVzVQkh"},{"type":"code","lang":"python","value":"@property\ndef data(self):\n    cache_valid = (\n        self._canonical_data is not None\n        and self._canonical_data_lvec_id == id(self._lvec)\n    )\n\n    if not cache_valid:\n        self._canonical_data = self._create_canonical_data_array()\n        self._canonical_data_lvec_id = id(self._lvec)\n\n    return self._canonical_data","position":{"start":{"line":87,"column":1},"end":{"line":100,"column":1}},"key":"o60nnKWaAX"},{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"No code path needs to manually invalidate the cache. No flag to set, no method to call. The cache validates itself on every access. If the underlying vector changed, the view rebuilds. If it didn’t, the cached view is returned immediately.","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"tkc7pVicUz"}],"key":"PU7XEVPfnB"},{"type":"heading","depth":2,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Batch Updates","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"XAYzQ29viJ"}],"identifier":"batch-updates","label":"Batch Updates","html_id":"batch-updates","implicit":true,"key":"V2XZi66MLU"},{"type":"paragraph","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"Sometimes you need to update several variables together. Each individual write triggers a PETSc synchronisation — which involves MPI communication. If you are setting initial conditions on velocity, pressure, and temperature, that is three synchronisation rounds where one would suffice.","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"TLIay6g0IK"