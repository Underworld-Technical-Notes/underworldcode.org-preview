 that we can generate unique tags. The ","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"nfC4Twt70F"},{"type":"inlineCode","value":"fetch","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"ULGdciHKEX"},{"type":"text","value":" command is acting asynchronously so we do need to be careful to name each tag uniquely as we don’t know the order in which the subsitutions will be made.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"GEoblbsvvv"}],"key":"qVZuzPjC9N"},{"type":"heading","depth":2,"position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"How can I use this ?","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"HA4gTWrMkd"}],"identifier":"how-can-i-use-this","label":"How can I use this ?","html_id":"how-can-i-use-this","implicit":true,"key":"uRl4NZaEeA"},{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"To find the groupID and collectionKey for a particular group library, look at the URL itself. For the library above, the format is ","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"DTfSr0Moqk"},{"type":"link","url":"https://www.zotero.org/groups/","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"https://​www​.zotero​.org​/groups/","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"fUAUH7qiuV"}],"urlSource":"https://www.zotero.org/groups/","key":"rEjyX25bWv"},{"type":"inlineCode","value":"2386948","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"xRdyHHnhPy"},{"type":"text","value":"/underworld-geodynamics-community/items/collectionKey/","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"UXu0vjQuqJ"},{"type":"inlineCode","value":"QNARWBUC","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"YaY2ah9QYl"},{"type":"text","value":".","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"ccBfDcuUR4"}],"key":"JQ7a74rwgw"},{"type":"paragraph","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"For an individual, you can access the “my publications” public library with the following script (again, looking at the zotero URL to work out who you are — unless you are me in which case this is already just fine).","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"dYJBJfpVNj"}],"key":"Zy9MMHcpUN"},{"type":"code","lang":"html","value":"<script>\nfor (let i = 2019; i >= 1995; i--) {\n   document.write(`<h2 > ${i} </h2>` );\n   document.write(`<div id=year${i}>` + `Loading ${i} publications </div>` );\n\n    fetch(`https://api.zotero.org/users/6049345/publications/items?format=bib&style=apa&linkwrap=1&q=${i}`)\n\t\t\t\t.then(function (response) {\n\t\t\t\t\treturn response.text();\n\t\t\t\t})\n\t\t\t\t.then(function(body) {\n\t\t\t\t\tdocument.getElementById(\"year\"+i).innerHTML = body;\n\t\t\t\t});\n    document.write(\"<br/>\")\n}\n</script>","position":{"start":{"line":90,"column":1},"end":{"line":106,"column":1}},"key":"pd7kJuKOds"},{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"For more information on how to use the zotero api consult","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"WscgAkRlk3"},{"type":"link","url":"https://www.zotero.org/support/dev/web%5Fapi/v3/start","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"their documentation","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"CEC6uLGwaC"}],"urlSource":"https://www.zotero.org/support/dev/web%5Fapi/v3/sta