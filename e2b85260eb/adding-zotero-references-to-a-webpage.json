\t\t}); \n    document.write(\"<br/>\")\n</script>","position":{"start":{"line":35,"column":1},"end":{"line":52,"column":1}},"key":"FJezTmygka"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"This works by sending a structured query to zotero asking for information for a specific library (here the  library for the underworld-community group which has an ID of ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"LDHvoRw4Ti"},{"type":"emphasis","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"2386948","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"xpnET1J4f4"}],"key":"eCIEFBcM3L"},{"type":"text","value":" and a specific collection of data with the Key of ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"tQmKds9gk6"},{"type":"emphasis","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"QNARWBUC","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"PQ35XoECEd"}],"key":"pjxcNArAgD"},{"type":"text","value":"). The result of the query is then loaded into the content of the ","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"HsSmZzLcvM"},{"type":"inlineCode","value":"<div id=\"pubs-2019\">","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"VOiUyIeJhC"},{"type":"text","value":" tag when the query has completed.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"rZTbPxZNlX"}],"key":"f574MCSqMl"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"It produces the following output","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"cO8SMAGjTm"}],"key":"sRziwHPuhL"},{"typ