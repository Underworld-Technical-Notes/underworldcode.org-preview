{"version":3,"kind":"Article","sha256":"70fe937e5589ef64eb9b8d2e966af04d595b9dc15759bbd17217d9d2fbc4ec48","slug":"getting-started-with-pull-requests","location":"/articles/getting-started-with-pull-requests/getting-started-with-pull-requests.md","dependencies":[],"frontmatter":{"title":"Getting started with Pull requests","banner":"/underworldcode.org-preview/e2b85260eb/build/banner-b2d951ee0d43b1bc4a818e53e6896410.jpg","keywords":["Tricks of the Trade","Documentation"],"authors":[{"nameParsed":{"literal":"Romain Beucher","given":"Romain","family":"Beucher"},"name":"Romain Beucher","orcid":"0000-0003-3891-5444","affiliations":["Australian National University"],"id":"contributors-getting-started-with-pull-requests-generated-uid-0"}],"affiliations":[{"id":"Australian National University","name":"Australian National University"}],"date":"2020-11-17","doi":"10.6084/m9.figshare.33193434","license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true}},"exports":[{"format":"md","filename":"getting-started-with-pull-requests.md","url":"/underworldcode.org-preview/e2b85260eb/build/getting-started-with-62626920d4fc7e6b67983ee5241734b4.md"},{"format":"typst","filename":"getting-started-with-pull-requests.pdf","url":"/underworldcode.org-preview/e2b85260eb/build/getting-started-with-d8c7071920c9b87a52afc335a7dec2e9.pdf"}],"open_access":true,"github":"https://github.com/underworld-technical-notes/underworldcode.org","numbering":{"title":{"offset":2}},"source_url":"https://github.com/underworld-technical-notes/underworldcode.org/blob/main/articles/getting-started-with-pull-requests/getting-started-with-pull-requests.md","edit_url":"https://github.com/underworld-technical-notes/underworldcode.org/edit/main/articles/getting-started-with-pull-requests/getting-started-with-pull-requests.md","thumbnail":"/underworldcode.org-preview/e2b85260eb/build/banner-b2d951ee0d43b1bc4a818e53e6896410.jpg"},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"div","class":"uwtn-banner","children":[{"type":"image","url":"/underworldcode.org-preview/e2b85260eb/build/banner-b2d951ee0d43b1bc4a818e53e6896410.jpg","key":"PXawyF03PD","urlSource":"figures/banner.jpg"}],"key":"k1xpG7M6pc"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Version control systems and online-communities such as Github have made contributing to the development of opensource software incredibly easy. That is assuming that people get over their initial fear of sharing their code!  In this short blog post I go through how to submit a pull request to one of our repository. Do not fear and join us for some fun! You may actually learn some interesting things along the way and we will acknowledge your contribution.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"cJlJ0VrmoD"}],"key":"bCSUKEdXK7"}],"key":"tTq8z9Vpvh"},{"type":"image","url":"/underworldcode.org-preview/e2b85260eb/build/github-mark-37277e22ec3defcf77da1523c8d742ec.png","width":"60px","align":"center","key":"nFm5cOmKSv","urlSource":"figures/github-mark.png"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"The open source community is by definition “open” to suggestions, new code submissions etc. The Underworld group adheres entirely to its philosophy and we aim at developing a broad community of not only users but contributors.  We have, however, been quite frustrated to see that very few people do submit pull requests to our code base.. and we would like you to help us fixing this!","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"g7zJlss2tb"}],"key":"LmxqdVfw8R"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Submitting fixes, new functionalities etc. is the best way to improve the code base. While we cannot guarantee that we will integrate the submission we can definitely review it. If you think there is something wrong or that there is a better way to do things, there is a good chance that YOU might be right, so instead of sending the developers an email that is very likely to get lost in the meanders of our crazy lives, take control on things and send us a pull request on Github!","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"yDzpByeMq1"}],"key":"kr95Av7qgG"},{"type":"heading","depth":2,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"What are Pull Requests and how do I create one?","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"HZ5mbFbcRR"}],"identifier":"what-are-pull-requests-and-how-do-i-create-one","label":"What are Pull Requests and how do I create one?","html_id":"what-are-pull-requests-and-how-do-i-create-one","implicit":true,"key":"cs3DkQVpD8"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Pull requests are a feature specific to GitHub. They provide a simple web-based way to submit changes to a code repository. It is called a ","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"CuGWqLLtaE"},{"type":"strong","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Pull request","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"TLX2jPtzVU"}],"key":"FQSC3k0hsh"},{"type":"text","value":" because you are asking the owner of a code to pull your changes from your fork...","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"F8bLa6zXGH"}],"key":"xH04H7fiXR"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"WTH is a Fork?","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"I7CXWAjp8v"}],"identifier":"wth-is-a-fork","label":"WTH is a Fork?","html_id":"wth-is-a-fork","implicit":true,"key":"kLgWUngou6"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"When you do development with Git, the best way to work on a new feature is to create a new branch using:","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"psiah1EUZ5"}],"key":"s3rY16WgUc"},{"type":"code","lang":"bash","value":"git checkout -b new_feature","position":{"start":{"line":46,"column":1},"end":{"line":48,"column":1}},"key":"QTiQn8aBcO"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"When the feature is completed, tested, etc. You can then merge the content of the ","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"YWWLgweg4m"},{"type":"strong","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"new_feature","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"DG7Un2Qn5z"}],"key":"AvPfLLAne2"},{"type":"text","value":" branch into the main branch (Note that you will have to commit your changes to your branch first):","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"uOpQk2zWMN"}],"key":"AgcDn174c4"},{"type":"code","lang":"bash","value":"git checkout development\ngit merge new_feature","position":{"start":{"line":52,"column":1},"end":{"line":55,"column":1}},"key":"uOpwFXqCmp"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"That is a perfectly valid way of doing things inside a development team.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"IuX48PnYtM"},{"type":"break","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"UvBjTn1GLP"},{"type":"text","value":"However, you need to be officially part of the team... That’s where ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"djPeY1I57F"},{"type":"strong","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"forks","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"VMUYcnpSvL"}],"key":"m1TyrRNPYj"},{"type":"text","value":" and ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"Sdjbrcv0Db"},{"type":"strong","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"pull requests","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"RMQNmQGdbR"}],"key":"OcrzGmvnUQ"},{"type":"text","value":" come to the rescue.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"UHLqJutEbl"}],"key":"JjjEHTE6FU"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Forks are basically copies of a repository at some point in time. It is called a fork because the changes you make are now dissociated from the main branch of development.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"FRYdA27bmG"}],"key":"RtCaoNTZQP"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"You create a fork from the GitHub Web User Interface by clicking on the ","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"e9R1g56L3U"},{"type":"strong","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"fork","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"WefhbGRQWH"}],"key":"M2Hb5MfD21"},{"type":"text","value":" button:","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"QjXkHEymOE"}],"key":"QolJyoA2PG"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/e2b85260eb/build/Screenshot-from-2020-cf8503b103a9770c4052ac853b4a12e7.png","key":"CzvKtvB5lx","urlSource":"figures/Screenshot-from-2020-11-17-09-58-44.png"}],"enumerator":"1","key":"LGbJ6gilBb"},{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Once you have done that, you have a copy of the repository appearing in your personal repositories with the url:","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"XaPxCLxWEp"}],"key":"Y3VwzGGIqY"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"inlineCode","value":"https://github.com/<YourUserName>/UWGeodynamics","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"HFi2UzbDrU"}],"key":"SqoY5ZOoZO"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"The fork includes all the code, branches, and commits from the original repository. You can then start doing some work.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"yzLwYrZ9AU"}],"key":"m8mtIxm78B"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"First you need to clone the repository on your local computer:","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"d1pPMceJQN"}],"key":"TasKUcSleD"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"inlineCode","value":"git clone https://github.com/<YourUserName>/UWGeodynamics","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"ZUpXl1a2Ni"}],"key":"bgXjQY0gVt"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"Once this is done, you should do 2 things:","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"LIzZL6g50T"}],"key":"Pmk2gKu2Sn"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":79,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":79,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Create a new branch to which you will commit your changes:\n","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"aBNVa0Jb22"},{"type":"inlineCode","value":"git checkout -b new_branch","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"TehOeN7Omt"}],"key":"YVNXYAjfNS"}],"key":"UlQ2GRBjUI"},{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"Create a new remote for the upstream repository:\n","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"nVA8cB71KY"},{"type":"inlineCode","value":"git remote add upstream https://github.com/underworldcode/UWGeodynamics","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"N5wfuyYwWc"}],"key":"w6oGG6k7oq"}],"key":"fn675YXC7Z"}],"key":"u9IatD0X1N"},{"type":"paragraph","posi