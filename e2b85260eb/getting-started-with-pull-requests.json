numerating objects: 4, done.\nCounting objects: 100% (4/4), done.\nDelta compression using up to 12 threads\nCompressing objects: 100% (2/2), done.\nWriting objects: 100% (3/3), 328 bytes | 328.00 KiB/s, done.\nTotal 3 (delta 1), reused 0 (delta 0), pack-reused 0\nremote: Resolving deltas: 100% (1/1), completed with 1 local object.\nremote: \nremote: Create a pull request for 'new_branch' on GitHub by visiting:\nremote:      https://github.com/rbeucher/UWGeodynamics/pull/new/new_branch\nremote: \nTo github.com:rbeucher/UWGeodynamics.git\n * [new branch]      new_branch -> new_branch\nBranch 'new_branch' set up to track remote branch 'new_branch' from 'origin'.","position":{"start":{"line":89,"column":1},"end":{"line":125,"column":1}},"key":"POsLsIhJYT"},{"type":"paragraph","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"Once you push the changes to your repository, the ","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"ZAMyyt2X3F"},{"type":"strong","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"strong","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"Compare & pull request","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"LxkjVhSaBZ"}],"key":"KW9aneJRuM"}],"key":"hzuR4wFAYN"},{"type":"text","value":" button will appear in GitHub.","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"hHX1CyAusV"}],"key":"Rw11kf1HyX"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/e2b85260eb/build/Screenshot-from-2020-105c7df17ef532677e901cd5e86a8757.png","key":"M4RjgqRsZU","urlSource":"figures/Screenshot-from-2020-11-17-10-40-16.png"}],"enumerator":"2","key":"olkj7aH6Wm"},{"type":"paragraph","position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"ch