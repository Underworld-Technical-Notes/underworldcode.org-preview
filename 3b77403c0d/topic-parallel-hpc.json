s Moresi","key":"zEKZtrJyCJ"}],"key":"dlsY8m10b3"},{"type":"div","class":"uwtn-entry-summary","children":[{"type":"text","value":"A notebook written against one version of Underworld should still run against that version in five years, on a machine that has nothing installed. Here is the machinery that makes that true: a compact container, a nearly empty launcher repository, and two GitHub workflows that make a release and its launcher in the same breath.","key":"IrVggqbE8H"}],"key":"syKfthQvu8"},{"type":"div","class":"uwtn-entry-links","children":[{"type":"link","class":"uwtn-read","url":"/running-underworld-in-a-browser/","children":[{"type":"text","value":"Read","key":"KUUtXVCvix"}],"urlSource":"/running-underworld-in-a-browser/","key":"fXCusgKyWE"},{"type":"text","value":" ","key":"iIcUs7yWIc"},{"type":"span","class":"uwtn-doi","children":[{"type":"span","class":"uwtn-doi-label","children":[{"type":"text","value":"doi","key":"AICWDV4oOr"}],"key":"SxPkVhh34B"},{"type":"text","value":"10.6084/m9.figshare.33216996","key":"QNZHkjnrIE"}],"key":"SwAAwN9flY"}],"key":"HrUlMJ9Ipk"},{"type":"div","class":"uwtn-tags","children":[{"type":"link","class":"uwtn-tag","url":"/topic-parallel-hpc/","children":[{"type":"text","value":"Parallel & HPC","key":"SUVGtKyC6d"}],"urlSource":"/topic-parallel-hpc/","key":"ejZiE3g9Gg"}],"key":"OM3C9AVBCZ"}],"key":"pyB0v3Vzcf"}],"key":"PpnhhdcIbe"},{"type":"div","class":"uwtn-entry","children":[{"type":"div","class":"uwtn-entry-text","children":[{"type":"div","class":"uwtn-entry-meta","children":[{"type":"span","class":"uwtn-id","children":[{"type":"text","value":"UWTN 2026-009","key":"DUbNJNNAnk"}],"key":"EJsHhcxsYW"},{"type":"span","class":"uwtn-date","children":[{"type":"text","value":"4 June 2026","key":"I7SE0WYCnw"}],"key":"Po7ny5yw7a"}],"key":"rCBy6paw8u"},{"type":"heading","depth":2,"children":[{"type":"link","url":"/finding-particles-in-a-distributed-unstructured-mesh/","children":[{"type":"text","value":"Finding Particles in a Distrib