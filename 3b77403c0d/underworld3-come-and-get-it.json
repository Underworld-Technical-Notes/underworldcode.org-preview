8,"column":1}},"children":[{"type":"text","value":"Underworld3 uses unstructured meshes supplied by gmsh or any other tool supported by PETSc. In this image we see flow driven from the left boundary around a series of obstacles visualised by streamlines. The intense colours appear where the flow is strongest which is also where the gaps between obstacles line up. There is an emergent pressure gradient displayed in the background shading.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"Pf2ac4pgks"}],"key":"sUqJ2UDEs6"}],"key":"uq0IMl4O6v"},{"type":"comment","value":" uwtn-acknowledgement ","key":"sl56038N3G"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"The Underworld project is supported by AuScope and the Australian Government through the National Collaborative Research Infrastructure Strategy (NCRIS). Source code:","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"r3xmfSLBzR"}],"key":"RMOvXpEz5V"},{"type":"text","value":" ","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"BEVv0lZnIn"},{"type":"link","url":"https://github.com/underworldcode/underworld3","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"github.com/underworldcode/underworld3","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"d9YAToPwB7"}],"key":"x3VbuliCUD"}],"urlSource":"https://github.com/underworldcode/underworld3","error":true,"key":"UjHTAfsfE1"}],"key":"vz4gt2UDhI"},{"type":"comment","value":" uwtn-acknowledgement ","key":"C9jCBdxtHs"},{"type":"div","class":"uwtn-discuss","children":[{"type":"div","class":"uwtn-discuss-head","children":[{"type":"text","value":"Comments","key":"Dq8JgS9R1Z"}],"key":"v8VzfU4Efm"},{"type":"div","class":"uwtn-discuss-body","children":[{"type":"text","value":"Discussion of these notes happens in GitHub Discussions, so it stays with the source and is searchable alongside it.","key":"gVzPmNWfId"}],"key":"he2aPsc7Zy"},{"type":"div","class":"uwtn-discuss-links","children":[{"type":"link","url":"https://github.com/Underworld-Technical-Notes/underworldcode.org/discussions?discussions_q=underworld3-come-and-get-it","children":[{"type":"text","value":"Read the discussion","key":"Wy8hh3YtoQ"}],"urlSource":"https://github.com/Underworld-Technical-Notes/underworldcode.org/discussions?discussions_q=underworld3-come-and-get-it","error":true,"key":"tXB0Bs04mB"},{"type":"link","url":"https://github.com/Underworld-Technical-Notes/underworldcode.org/discussions/new?category=general&title=underworld3-come-and-get-it","children":[{"type":"text","value":"Start one","key":"PKupc8UMNN"}],"urlSource":"https://github.com/Underworld-Technical-Notes/underworldcode.org/discussions/new?category=general&title=underworld3-come-and-get-it","error":true,"key":"Zt8YhqyCf2"}],"key":"t3o7F9BFa2"}],"key":"a2S9MgHHph"}],"key":"EGTBexk2C0"}],"key":"gqvzJO4LCw"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Underworld and Singularity","url":"/underworld-and-singularity","group":"2025"},"next":{"title":"30 Years of Citcom, Ellipsis and Underworld","url":"/30-years-of-citcom-ellipsis-and-underworld","group":"2024"}}},"domain":"http://localhost:3000"}