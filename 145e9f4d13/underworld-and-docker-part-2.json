erworld-technical-notes/underworldcode.org/edit/main/articles/underworld-and-docker-part-2/underworld-and-docker-part-2.md","thumbnail":"/underworldcode.org-preview/145e9f4d13/build/banner-3d2cc8b1a61a692c1977537dd45afc94.png"},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"div","class":"uwtn-banner","children":[{"type":"image","url":"/underworldcode.org-preview/145e9f4d13/build/banner-3d2cc8b1a61a692c1977537dd45afc94.png","key":"k7hnyjaf48","urlSource":"figures/banner.png"}],"key":"HyOuNDwdsE"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"By the way, before you read this post, catch up with how we use ","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"JXOizkjdYe"},{"type":"inlineCode","value":"docker","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"udFyOw3ZuN"},{"type":"text","value":" by reading part 1","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"kaTeUMKaVM"}],"key":"t52E3fiuS6"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Docker allows us to distribute pre-built applications which are hosted in a virtual machine and are therefore platform independent. This simplifies things for us (only one platform we need to support) and for the users (you get a universal binary with complete reproducibility across platforms). However, if you are not running on a native linux machine, you have to understand the way docker works before being able to access the binary.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"rfnh87cqYZ"}],"key":"OevQsChAK1"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Docker allows us to provide a single image to our users but not a consistent user experience. ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"YvdMM27HIm"},{"type":"inlineCode","value":"Kitematic","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"XMIu1b6tPT"},{"type":"text","value":" is a Docker-supported user interface which allows users to discover and run Docker containers and interact with them in a predictable manner. With ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"vYTi7xocrs"},{"type":"inlineCode","value":"Kitematic","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"pvg12L7pWy"},{"type":"text","value":" you can download and run the Underworld containers through a gui which provides clickable links to the notebook server.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"QawUdGAJcl"}],"key":"dxFXCSZjeC"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"At present, ","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"YRZwbPVvO3"},{"type":"inlineCode","value":"Kitematic","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"ej0InXlrAY"},{"type":"text","value":" is a mac application and an alpha version exists for windows (and we can already tell you how to launch a browser directly into the notebooks on linux).","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"i7y5MhmGGr"}],"key":"mLkXwjEEhj"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Getting started","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"QbAgBlXF3e"}],"identifier":"getting-started","label":"Getting started","html_id":"getting-started","implicit":true,"key":"XvlqSsfmEA"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Launching ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"I8GSBEsO9G"},{"type":"inlineCode","value":"Kitematic","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"wa3dKQvMYz"},{"type":"text","value":" for the first time brings up an app-store-like list of available containers. Underworld2 is available through the Docker hub and so can be discovered by searching:","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"uOihMN98GJ"}],"key":"ZB3ApIpUtW"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/145e9f4d13/build/Kitematic4-e68550fef46fd348eb55fcf60775e51d.png","alt":"Kitematic4","key":"InYxr6BbWA","urlSource":"figures/Kitematic4.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Run Kitematic and search for Underworld2","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"vDgd1uW9Uj"}],"key":"xCqiEgQNdR"}],"key":"cW1m1DhQ4K"}],"enumerator":"1","key":"Qkrt2ve6NR"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Clicking ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"aQy05JIAs1"},{"type":"inlineCode","value":"Create","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"s05krugQN2"},{"type":"text","value":" on the ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"wghE1o8p5s"},{"type":"emphasis","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Underworld2","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"Ni17MNkOU3"}],"key":"WIMyRZcbdA"},{"type":"text","value":" container will automatically download it and launch into the default configuration. This container is tested code from the release branch. If you want a specific version, check out the tags (at the moment we don’t have a history of past releases though !). The ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"AQTRlf135d"},{"type":"emphasis","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Underworld2-dev","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"IpNCETzq4h"}],"key":"nBjKfdOKG6"},{"type":"text","value":" container is a rolling build which is updated from the development branch whenever there are changes. You can rename your container from the General / Settings tab which is not such a bad idea if you are using the latest build of a development branch because the container, once created, is an immutable snapshot of that version of the code.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"DhbvRSFYon"}],"key":"NoCRL4t6ha"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/145e9f4d13/build/Kitematic3-23c31a9691845dffcfa06e7b3d00dba6.png","alt":"Kitematic3","key":"txJxKRDGqk","urlSource":"figures/Kitematic3.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Once Underworld is running, you will see a web-preview under the Home tab. In the windows alpha version this will be blank, but clicking on it will open the correct container in your browser.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"OfJfj0FUDs"}],"key":"gvk3Eb57eN"}],"key":"BKIaqd5gDd"}],"key":"NG8opGoTJs"}],"enumerator":"2","key":"MR8phxeky6"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"The underworld container is set to serve up the User Guide (notebooks) by default. If you click on the web-preview it will launch your default browser with the appropriate IP address and port (you can change the port in the settings if you want).","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"eL2BNtqJfF"}],"key":"EJuRuswr2y"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/145e9f4d13/build/Kitematic2-d08adc1f34c4832aa582c506c0b0ba4b.png","alt":"Kitematic2","key":"z9CEB29vYb","urlSource":"figures/Kitematic2.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"The web browser opens to the default IP address and port for the virtual machine running the underworld notebooks.","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"HrKmmBYUHZ"}],"key":"wvbEXFxHAx"}],"key":"BXyjBHzOWV"}],"enumerator":"3","key":"JghWwBm60u"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"When you run the notebooks in your browser, the virtual machine will show the output of the code in the main window (see Figure 2 above). Any output and changes you make to the notebooks - and any new notebooks - will appear within the virtual environment. The simplest way to access the machine itself is also via the web browser. You can start a new terminal from the homepage (Figure 3) of the notebook session. This brings into a shell in the root directory of the virtual machine running underworld. Try running ","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"ReG1sQRoXU"},{"type":"inlineCode","value":"uname -a","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"FWGsthMvVk"},{"type":"text","value":", it won’t look very mac-like.","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"OXT65c5BXB"}],"key":"BgU2qZGahL"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/145e9f4d13/build/Kitematic6-6210b847bc690f6a13adbf110013d2fb.png","alt":"Kitematic6","key":"NQivPZifTp","urlSource":"figures/Kitematic6.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"‌‌Launching a new terminal from the notebook home screen is a quick way into the virtual machine.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"VssbwkdV3t"}],"key":"KktQjKyvbA"}],"key":"Iwm6wHxMxT"}],"enumerator":"4","key":"z2FfGqsEah"},{"type":"heading","depth":2,"position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"How to work with your own notebooks using ","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"oC5Q06vcMX"},{"type":"inlineCode","value":"Kitematic","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"iQ9nHcDgHE"}],"identifier":"how-to-work-with-your-own-notebooks-using-kitematic","label":"How to work with your own notebooks using Kitematic","html_id":"how-to-work-with-your-own-notebooks-using-kitematic","implicit":true,"key":"nHdY7Q4RIR"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"It does not make sense to keep all of your own work inside the virtual environment. If you want to manage your own data and keep notebooks synchronised / versioned in your own repository, and collaborate with others using shared space, then you can connect this space through to the virtual environment visible to the underworld machine.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"SPwoiIpjNd"}],"key":"RchbYsIvvl"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"This is done through the settings tab of the container","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"LMcWZGbvRx"}],"key":"Q892Pm876n"},{"type":"container","kind":"figure","children":[{"type":"container","kind":"figure","subcontainer":true,"children":[{"type":"image","url":"/underworldcode.org-preview/145e9f4d13/build/Kitematic6i-b27d24e36bf9a1424a307bb215739dd6.png","alt":"Allowing the outside world into the container by mounting a local directory.","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"data":{"altTextIsAutoGenerated":true},"key":"f1FdxJPXYt","urlSource":"figures/Kitematic6i.png"}],"parentEnumerator":"5","enumerator":"a","key":"r3p7ZnPHGM"},{"type":"container","kind":"figure","subcontainer":true,"children":[{"type":"image","url":"/underworldcode.org-preview/145e9f4d13/build/Kitematic6ii-0ce07ae7218211534d35cdefaacda2b0.png","alt":"Allowing the outside world into the container by mounting a local directory.","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"data":{"altTextIsAutoGenerated":true},"key":"U3iBcNlCj9","urlSource":"figures/Kitematic6ii.png"}],"parentEnumerator":"5","enumerator":"b","key":"HytdoBft8C"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"Allowing the outside world into the container by mounting a local directory.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"zExcDtCR96"}],"key":"hYjPUabTbZ"}],"key":"DBm5cTqHQl"}],"enumerator":"5","key":"illF1sbKX2"},{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"When the workspace is set to ","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"r8lAKc72hq"},{"type":"inlineCode","value":"no folder","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"t2TLrCyOpR"},{"type":"text","value":", all data is written within the container itself. When you choose a folder in the outside world, this is the default workspace which the underworld2 environment uses. Notebooks can be run from within that directory or its sub-directories and can also be accessed from the standard filesystem. If you have data which you want to share between different containers, you can point them all to some common space. The usual caveats apply though if you have several machines trying to use common files or write to a common directory.","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"FzACvkNYiG"}],"key":"jm533yE5bA"},{"type":"paragraph","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"You can access the contents of the ","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"RzM8NJx3S2"},{"type":"inlineCode","value":"/workspace","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"GG8Pby68Mh"},{"type":"text","value":" volume to save any changes you make within the container because ","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"hX5A2nltys"},{"type":"inlineCode","value":"Kitematic","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"Eg7uYOnvMW"},{"type":"text","value":" tries to mount these locally in a default location see ","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"J2MHdMzgNd"},{"type":"link","url":"https://kitematic.com/docs/managing-volumes/","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"https://​kitematic​.com​/docs​/managing​-volumes/","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"kDZogrvMdN"}],"urlSource":"https://kitematic.com/docs/managing-volumes/","key":"eojrZAtSsn"},{"type":"text","value":" for details. You need to click the volume first to prompt the program to do this.","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"prg1I0Y52u"}],"key":"vL2xOM6f35"},{"type":"heading","depth":2,"position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"Caution !!","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"mypuNixkYq"}],"identifier":"caution","label":"Caution !!","html_id":"caution","implicit":true,"key":"VBjKBgWtTK"},{"type":"paragraph","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Some actions within Kitematic have unexpected side effects. Renaming a container actually will stop and restart it which means it reverts to the original image and you will lose any changes you have made within the container.","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"acovxe8qJb"}],"key":"ilP5Hzt6qI"},{"type":"div","class":"uwtn-discuss","children":[{"type":"div","class":"uwtn-discuss-head","children":[{"type":"text","value":"Comments","key":"COoT8AIo9Y"}],"key":"GJXy4cbSl5"},{"type":"div","class":"uwtn-discuss-body","children":[{"type":"text","value":"Discussion of these notes happens in GitHub Discussions, so it stays with the source and is searchable alongside it.","key":"bnV1LOjtsQ"}],"key":"omXQ1tjop9"},{"type":"div","class":"uwtn-discuss-links","children":[{"type":"link","url":"https://github.com/Underworld-Technical-Notes/underworldcode.org/discussions?discussions_q=underworld-and-docker-part-2","children":[{"type":"text","value":"Read the discussion","key":"fGjaC7VQRH"}],"urlSource":"https://github.com/Underworld-Technical-Notes/underworldcode.