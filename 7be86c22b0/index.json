{"version":3,"kind":"Article","sha256":"6e239ba0ba15f0c0b597ed5954410153666a1af09aa92d10f4cd43f9fdb647ce","slug":"index","location":"/index.md","dependencies":[],"frontmatter":{"title":"Preview","site":{"hide_outline":true},"open_access":true,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true},"code":{"id":"MIT","url":"https://opensource.org/licenses/MIT","name":"MIT License","free":true,"osi":true}},"github":"https://github.com/underworld-technical-notes/underworldcode.org","source_url":"https://github.com/underworld-technical-notes/underworldcode.org/blob/main/index.md","edit_url":"https://github.com/underworld-technical-notes/underworldcode.org/edit/main/index.md","exports":[{"format":"md","filename":"index.md","url":"/underworldcode.org-preview/7be86c22b0/build/index-ff079e53c5fe721d4b8bc73e5d26b334.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"div","class":"uwtn-masthead","children":[{"type":"div","class":"uwtn-kicker","children":[{"type":"text","value":"Preview","key":"n7AYeCb6c3"}],"key":"HPVEID9Tkh"},{"type":"div","class":"uwtn-wordmark","children":[{"type":"text","value":"Under review","key":"QjoPBbR47o"}],"key":"hIfSTgFgaB"},{"type":"div","class":"uwtn-standfirst","children":[{"type":"text","value":"Only the notes changed on this branch were built. The rest of the site is not here, which is why this was quick.","key":"oAojBjSzoq"}],"key":"vESpc3vQtU"}],"key":"q3zh3PGVEF"},{"type":"div","class":"uwtn-feed","children":[{"type":"div","class":"uwtn-entry","children":[{"type":"div","class":"uwtn-entry-text","children":[{"type":"heading","depth":2,"children":[{"type":"link","url":"/faults-on-an-add-on-mesh/","children":[{"type":"text","value":"Faults and patch-refinement of the mesh","key":"yONVfLsMA5"}],"urlSource":"/faults-on-an-add-on-mesh/","key":"E4NqHxXNv3"}],"identifier":"faults-and-patch-refinement-of-the-mesh","label":"Faults and patch-refinement of the mesh","html_id":"faults-and-patch-refinement-of-the-mesh","implicit":true,"key":"uOuUmsHC8Y"},{"type":"div","class":"uwtn-entry-summary","children":[{"type":"text","value":"A slipping fault is a discontinuity the mesh has to represent, along a trace that moves as the model runs. We build the fault into a short-lived mesh made from a static base. The base holds the state, the partition and the coarse multigrid levels; the add-on is a copy of the base's finest level with the fault placed into it as a narrow structured band, split along the fault, and rebuilt from the base whenever the fault moves.","key":"ep37wsJ80S"}],"key":"UBLTYTPTXG"}],"key":"xdHjmFlS0G"}],"key":"CtAnZma9nv"}],"key":"ChnixO31wa"}],"key":"B4YOjqpSBh"}],"key":"zoFdx8qIAJ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"Faults and patch-refinement of the mesh","url":"/faults-on-an-add-on-mesh","group":"Underworld Geodynamics"}}},"domain":"http://localhost:3000"}