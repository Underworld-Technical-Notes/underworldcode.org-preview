{"version":3,"kind":"Article","sha256":"6e239ba0ba15f0c0b597ed5954410153666a1af09aa92d10f4cd43f9fdb647ce","slug":"index","location":"/index.md","dependencies":[],"frontmatter":{"title":"Preview","site":{"hide_outline":true},"open_access":true,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true},"code":{"id":"MIT","url":"https://opensource.org/licenses/MIT","name":"MIT License","free":true,"osi":true}},"github":"https://github.com/underworld-technical-notes/underworldcode.org","source_url":"https://github.com/underworld-technical-notes/underworldcode.org/blob/main/index.md","edit_url":"https://github.com/underworld-technical-notes/underworldcode.org/edit/main/index.md","exports":[{"format":"md","filename":"index.md","url":"/underworldcode.org-preview/7be86c22b0/build/index-25f1783abafedd254257b2212f5ce3a7.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"div","class":"uwtn-masthead","children":[{"type":"div","class":"uwtn-kicker","children":[{"type":"text","value":"Preview","key":"ncs72cu08x"}],"key":"Gkzijyxi3k"},{"type":"div","class":"uwtn-wordmark","children":[{"type":"text","value":"Under review","key":"tmfwUHRNKJ"}],"key":"tNPgbAj9LO"},{"type":"div","class":"uwtn-standfirst","children":[{"type":"text","value":"Only the notes changed on this branch were built. The rest of the site is not here, which is why this was quick.","key":"I5hQPKCAmU"}],"key":"zg0Vxhgy3U"}],"key":"ilZY4iYXtM"},{"type":"div","class":"uwtn-feed","children":[{"type":"div","class":"uwtn-entry","children":[{"type":"div","class":"uwtn-entry-text","children":[{"type":"heading","depth":2,"children":[{"type":"link","url":"/faults-on-an-add-on-mesh/","children":[{"type":"text","value":"Faults and patch-refinement of the mesh","key":"IMmcsPdG6F"}],"urlSource":"/faults-on-an-add-on-mesh/","key":"lJJTraj2Lh"}],"identifier":"faults-and-patch-refinement-of-the-mesh","label":"Faults and patch-refinement of the mesh","html_id":"faults-and-patch-refinement-of-the-mesh","implicit":true,"key":"ITkO8WoY8r"},{"type":"div","class":"uwtn-entry-summary","children":[{"type":"text","value":"A slipping fault is a discontinuity the mesh has to represent, along a trace that moves as the model runs. We build the fault into a short-lived mesh made from a static base. The base holds the state, the partition and the coarse multigrid levels; the add-on is a copy of the base's finest level with the fault placed into it as a narrow structured band, split along the fault, and rebuilt from the base whenever the fault moves.","key":"eeusqrKPKY"}],"key":"gggiOzTT3A"}],"key":"vhd4NHq9jw"}],"key":"UIuJBrY1HA"}],"key":"zEzrmqpjcy"}],"key":"VnHhIw5WHP"}],"key":"g2e2tx48Pc"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"Faults and patch-refinement of the mesh","url":"/faults-on-an-add-on-mesh","group":"Underworld Geodynamics"}}},"domain":"http://localhost:3000"}