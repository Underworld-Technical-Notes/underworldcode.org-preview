without-remaking-it","label":"Moving the Mesh Without Remaking It","html_id":"moving-the-mesh-without-remaking-it","implicit":true,"key":"nXxbFaa1E7"},{"type":"div","class":"uwtn-entry-summary","children":[{"type":"text","value":"There are three ways to put resolution where a calculation needs it: rebuild the mesh, subdivide it, or move its nodes. The third conserves the node budget and leaves the connectivity, the parallel partition and the multigrid hierarchy untouched — nothing is created or destroyed, only relocated. How that redistribution works in Underworld3, what it is worth in numbers, and where its ceiling is.","key":"JaqpsGeuMd"}],"key":"EbF48g6sty"}],"key":"bYYUPliVdZ"}],"key":"mS25Gfr1HC"},{"type":"div","class":"uwtn-entry","children":[{"type":"div","class":"uwtn-entry-text","children":[{"type":"heading","depth":2,"children":[{"type":"link","url":"/running-underworld-in-a-browser/","children":[{"type":"text","value":"Running Underworld in a Browser: Any Repository, Any Version","key":"CMHHni5OyV"}],"urlSource":"/running-underworld-in-a-browser/","key":"l48uL56BQJ"}],"identifier":"running-underworld-in-a-browser-any-repository-any-version","label":"Running Underworld in a Browser: Any Repository, Any Version","html_id":"running-underworld-in-a-browser-any-repository-any-version","implicit":true,"key":"QEzEDvMyzm"},{"type":"div","class":"uwtn-entry-summary","children":[{"type":"text","value":"A notebook written against one version of Underworld should still run against that version in five years, on a machine that has nothing installed. Here is the machinery that makes that true: a compact container, a nearly empty launcher repository, and two GitHub workflows that make a release and its launcher in the same breath.","key":"zjXnfWMRWp"}],"key":"ng3YiJJHpM"}],"key":"g0EtRSxZiP"}],"key":"r1F95Y2k9N"}],"key":"aeDdD1cLxg"}],"key":"hKylXNmaEK"}],"key":"T3GB9Ex3l7"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"Moving the Mesh Without Remaking It","url":"/moving-the-mesh-without-remaking-it","group":"Underworld Technical Notes"}}},"domain":"http://localhost:3000"}