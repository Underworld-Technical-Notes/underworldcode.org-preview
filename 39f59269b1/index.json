without-remaking-it","label":"Moving the Mesh Without Remaking It","html_id":"moving-the-mesh-without-remaking-it","implicit":true,"key":"UCar3cuvN9"},{"type":"div","class":"uwtn-entry-summary","children":[{"type":"text","value":"There are three ways to put resolution where a calculation needs it: rebuild the mesh, subdivide it, or move its nodes. The third conserves the node budget and leaves the connectivity, the parallel partition and the multigrid hierarchy untouched — nothing is created or destroyed, only relocated. How that redistribution works in Underworld3, what it is worth in numbers, and where its ceiling is.","key":"kozqwggfB5"}],"key":"X3nuvzhek7"}],"key":"ukMMJZ6SrP"}],"key":"OHqYwJFY7o"},{"type":"div","class":"uwtn-entry","children":[{"type":"div","class":"uwtn-entry-text","children":[{"type":"heading","depth":2,"children":[{"type":"link","url":"/running-underworld-in-a-browser/","children":[{"type":"text","value":"Running Underworld in a Browser: Any Repository, Any Version","key":"Dlzz2jgdNa"}],"urlSource":"/running-underworld-in-a-browser/","key":"Tv4hPBoBOE"}],"identifier":"running-underworld-in-a-browser-any-repository-any-version","label":"Running Underworld in a Browser: Any Repository, Any Version","html_id":"running-underworld-in-a-browser-any-repository-any-version","implicit":true,"key":"JMMmGbKdou"},{"type":"div","class":"uwtn-entry-summary","children":[{"type":"text","value":"A notebook written against one version of Underworld should still run against that version in five years, on a machine that has nothing installed. Here is the machinery that makes that true: a compact container, a nearly empty launcher repository, and two GitHub workflows that make a release and its launcher in the same breath.","key":"jd81tL2bXk"}],"key":"ofFnMelnAv"}],"key":"MDdFDU0bZw"}],"key":"HRW28gWHww"}],"key":"Qebqmo3oy1"}],"key":"wLqmpISNeo"}],"key":"GcrnHeHnf2"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"Moving the Mesh Without Remaking It","url":"/moving-the-mesh-without-remaking-it","group":"Underworld Technical Notes"}}},"domain":"http://localhost:3000"}