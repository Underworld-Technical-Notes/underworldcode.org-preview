world-and-docker-part-2.md"},{"file":"articles/underworld-and-docker-part-1/underworld-and-docker-part-1.md"}],"title":"2015"}],"title":"News & guides"},{"children":[{"file":"topics/topic-benchmarks-validation.md"},{"file":"topics/topic-earthquakes-faults.md"},{"file":"topics/topic-finite-elements.md"},{"file":"topics/topic-mantle-convection.md"},{"file":"topics/topic-meshing.md"},{"file":"topics/topic-parallel-hpc.md"},{"file":"topics/topic-particles-swarms.md"},{"file":"topics/topic-rheology.md"},{"file":"topics/topic-solvers.md"},{"file":"topics/topic-surface-processes.md"},{"file":"topics/topic-symbolic-codegen.md"},{"file":"topics/topic-tectonics-lithosphere.md"},{"file":"topics/topic-time-integration.md"},{"file":"topics/topic-units-scaling.md"}],"file":"topics/topics.md"}],"thumbnail":"/landing-convection-c1ee4f8d3d09123a2c4a24b68633d60b.gif","exports":[],"bibliography":[],"index":"index","pages":[{"level":1,"title":"About"},{"slug":"ugcomm","title":"Who we are","description":"","date":"","thumbnail":"","thumbnailOptimized":"","banner":"","bannerOptimized":"","tags":[],"level":2},{"slug":"credits","title":"Credits","description":"","date":"","thumbnail":"","thumbnailOptimized":"","banner":"","bannerOptimized":"","tags":[],"level":2},{"slug":"how-to-cite-underworld","title":"How to cite","description":"","date":"","thumbnail":"","thumbnailOptimized":"","banner":"","bannerOptimized":"","tags":[],"level":2},{"level":1,"title":"Underworld"},{"slug":"intro-to-underworld","title":"Introduction to Underworld","description":"","date":"","thumbnail":"","thumbnailOptimized":"","banner":"","bannerOptimized":"","tags":[],"level":2},{"slug":"auscope-cloud","title":"Run in the cloud","description":"","date":"","thumbnail":"/b77199e99a54e59b2e3c037c2cc90f21.svg","thumbnailOptimized":"","banner":"","bannerOptimized":"","tags":[],"level":2},{"slug":"underworld-model-exchange","title":"Model exchange","description":"","date":"","thumbnail":"","thumbnailOptimized":"","banner":"","bannerOptimized":"","tags":[],"level":2},{"slug":"publications-using-uw","title":"Publications using Underworld","description":"","date":"","thumbnail":"","thumbnailOptimized":"","banner":"","bannerOptimized":"","tags":[],"level":2},{"level":1,"title":"Technical Notes"},{"slug":"notes","title":"Underworld Technical Notes","description":"","date":"","thumbnail":"/banner-3c7a1d2ff2f650deb662639ec8265927.jpg","thumbnailOptimized":"","banner":"","bannerOptimized":"","tags":[],"level":2},{"level":2,"title":"2026"},{"slug":"boundary-conditions-on-non-planar-boundaries","title":"Free-Slip boundary conditions on curved boundaries","description":"\"No flow through this wall\" is a single velocity component on a box and is not a component of anything on a sphere, a deformed mesh, or a surface with topography. Three ways to impose it — a direct penalty, Nitsche, and rotating the degrees of freedom — what each costs, and the one measurement that tells them apart.","date":"2026-08-18","thumbnail":"/banner-3c7a1d2ff2f650deb662639ec8265927.jpg","thumbnailOptimized":"","banner":"/banner-3c7a1d2ff2f650deb662639ec8265927.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"setting-up-full-multigrid","title":"Setting Up Full Multigrid","description":"Underworld can precondition a Stokes solve with geometric multigrid built from a real hierarchy of meshes, rather than with the algebraic multigrid it falls back to. What the difference is, how to build a mesh that has a hierarchy, and when the choice is worth making.","date":"2026-08-14","thumbnail":"/banner-ff19e428c9f45b0bb086acae09ed487c.png","thumbnailOptimized":"","banner":"/banner-ff19e428c9f45b0bb086acae09ed487c.png","bannerOptimized":"","tags":[],"level":3},{"slug":"moving-the-mesh-without-remaking-it","title":"Moving the Mesh Without Remaking It","description":"There are three ways to put resolution where a calculation needs it: rebuild the mesh, subdivide it, or move its nodes. The third conserves the node budget and leaves the connectivity, the parallel partition and the multigrid hierarchy untouched — nothing is created or destroyed, only relocated. How that redistribution works in Underworld3, what it is worth in numbers, and where its ceiling is.","date":"2026-08-13","thumbnail":"/banner-bf5827d377dcba3953b3aaa3fa5ff723.jpg","thumbnailOptimized":"","banner":"/banner-bf5827d377dcba3953b3aaa3fa5ff723.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"running-underworld-in-a-browser","title":"Running Underworld in a Browser: Any Repository, Any Version","description":"A notebook written against one version of Underworld should still run against that version in five years, on a machine that has nothing installed. Here is the machinery that makes that true: a compact container, a nearly empty launcher repository, and two GitHub workflows that make a release and its launcher in the same breath.","date":"2026-08-11","thumbnail":"/banner-2cc7af4955369932558474e185cc2f64.jpg","thumbnailOptimized":"","banner":"/banner-2cc7af4955369932558474e185cc2f64.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"finding-particles-in-a-distributed-unstructured-mesh","title":"Finding Particles in a Distributed, Unstructured Mesh","description":"It can be difficult to figure out where you are in an unstructured mesh of triangles or tetrahedra; worse when the mesh is distributed in parallel. We have to solve this problem for particle-in-cell type codes such as Underworld3. This is how we do it.","date":"2026-06-04","thumbnail":"/banner-028ce8be38bfec9ad04396fa995e42fc.jpg","thumbnailOptimized":"","banner":"/banner-028ce8be38bfec9ad04396fa995e42fc.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"particles-in-underworld3","title":"Particles in Underworld3","description":"Underworld is built around the idea of active Lagrangian tracer particles that carry history and composition information as the material deforms. How do we combine this information with our symbolic mathematical framework ?","date":"2026-06-03","thumbnail":"/banner-0315898852d40a8bb676925e2c1b3144.jpg","thumbnailOptimized":"","banner":"/banner-0315898852d40a8bb676925e2c1b3144.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"symbolic-time-derivatives-in-underworld3","title":"Symbolic Time Derivatives in Underworld3","description":"In Underworld3, the time derivative is a symbolic object. It appears in the solver's strong form as a SymPy expression, alongside the constitutive stress and the body force.","date":"2026-04-16","thumbnail":"/banner-a5f19869369e04b2ace4298b863ef12a.jpg","thumbnailOptimized":"","banner":"/banner-a5f19869369e04b2ace4298b863ef12a.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"constitutive-models-in-symbolic-form","title":"Constitutive Models in Symbolic Form","description":"A constitutive model is a Python class where the relationship between fluxes and gradients is encoded in SymPy. At every stage the mathematics is visible, inspectable, and differentiable. The framework handles Jacobians, C code generation, and PETSc integration. You handle the physics.","date":"2026-04-13","thumbnail":"/banner-df18aec6c2403a427941443a017fe5e4.jpg","thumbnailOptimized":"","banner":"/banner-df18aec6c2403a427941443a017fe5e4.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"physical-units-in-computational-geodynamics","title":"Physical Units in Computational Geodynamics","description":"Non-dimensionalisation (rewriting problems to make them re-scalable from lab to the real world) is a specialised task that all modellers confront at some point. It is important for accurate and efficient numerical solutions. Can we take away the pain that comes with the task ?","date":"2026-04-08","thumbnail":"/banner-316f453412f0443760e0d4ade26b8309.jpg","thumbnailOptimized":"","banner":"/banner-316f453412f0443760e0d4ade26b8309.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"mesh-variables-and-petsc-vectors-keeping-arrays-in-sync","title":"Mesh Variables and PETSc Vectors: Keeping Arrays in Sync","description":"One of the less glamorous but important problems in a finite element framework is this: how does the user assign values to a field variable, and how does the framework ensure that PETSc sees those values correctly, in parallel, without the user needing to keep track themselves?","date":"2026-04-03","thumbnail":"/banner-b3f140fcae16389186035f56a37ce5ed.jpg","thumbnailOptimized":"","banner":"/banner-b3f140fcae16389186035f56a37ce5ed.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"how-underworld3-turns-sympy-into-c","title":"How Underworld3 Turns SymPy into C","description":"What actually happens between the moment you write a mathematical expression in underworld3's python layer and the moment PETSc receives a finite element term in the form of compiled C code ?","date":"2026-04-01","thumbnail":"/banner-8ce82f3d408836964cb31d25cde0f51e.jpg","thumbnailOptimized":"","banner":"/banner-8ce82f3d408836964cb31d25cde0f51e.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"ai-and-scientific-software-what-we-learned-rebuilding-underworld3","title":"AI and Scientific Software: What We Learned Rebuilding Underworld3","description":"Underworld3 has about 50,000 lines of Python/ Cython wrapping PETSc, SymPy, and a just-in-time compiler. I began a trial of AI coding tools in 2025 and they have gradually become central to the way our team works. This is a story of co-evolution as much as it is about adoption of a new set of tools.","date":"2026-03-23","thumbnail":"/banner-de2ad04ad726267c19c521d8abc33643.jpg","thumbnailOptimized":"","banner":"/banner-de2ad04ad726267c19c521d8abc33643.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"our-journey-from-underworld2-to-underworld3","title":"Our Journey from Underworld2 to Underworld3","description":"Underworld is a code for geodynamics — mantle convection, lithospheric deformation, subduction, ice flow. We solve coupled, nonlinear PDEs with complex rheologies using Lagrangian particles to track material history. The project has been running for 20 years: why did we start again ?","date":"2026-03-23","thumbnail":"/banner-af2e48c0de7fba13457b03ec1233d273.jpg","thumbnailOptimized":"","banner":"/banner-af2e48c0de7fba13457b03ec1233d273.jpg","bannerOptimized":"","tags":[],"level":3},{"level":2,"title":"2025"},{"slug":"new-features-of-the-surface-coupling-framework-in-underworld-2","title":"New features of the surface-coupling framework in Underworld 2","description":"","date":"2025-08-25","thumbnail":"/banner-474cc5aee9d8d6f9814bda3917eb4b40.png","thumbnailOptimized":"","banner":"/banner-474cc5aee9d8d6f9814bda3917eb4b40.png","bannerOptimized":"","tags":[],"level":3},{"slug":"how-many-processors-should-we-use-to-solve-problem-x","title":"How many processors should we use to solve Problem X?","description":"Parallel computation puts many CPUs to work on solving a problem much more quickly than one CPU alone. But this only works if the tasks are carefully scheduled and the additional CPUs are not waiting around for something to do. How do we choose the right number of processors for a given problem ?","date":"2025-07-27","thumbnail":"/banner-b3acdb3544ddf7baa520d856c3a649ee.jpg","thumbnailOptimized":"","banner":"/banner-b3acdb3544ddf7baa520d856c3a649ee.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"underworld-and-singularity","title":"Underworld and Singularity","description":"TL; DR: Underworld is now Singularity-enabled, making it easier and somewhat quicker to use compared to traditional HPC installs. We demonstrate results using over 10,000 CPUs and more than one billion unknowns for solving the Stokes equation with Underworld 2.16","date":"2025-04-09","thumbnail":"/banner-d977e165edf06095d02030d1aad6b059.jpg","thumbnailOptimized":"","banner":"/banner-d977e165edf06095d02030d1aad6b059.jpg","bannerOptimized":"","tags":[],"level":3},{"level":2,"title":"2024"},{"slug":"underworld3-come-and-get-it","title":"Underworld3","description":"Introducing Underworld3: Mathematically Self-Describing Modelling in Python for Desktop, HPC and Cloud.","date":"2024-12-08","thumbnail":"/banner-ab9307f66cffb36114519ac07c96e4f4.png","thumbnailOptimized":"","banner":"/banner-ab9307f66cffb36114519ac07c96e4f4.png","bannerOptimized":"","tags":[],"level":3},{"slug":"30-years-of-citcom-ellipsis-and-underworld","title":"30 Years of Citcom, Ellipsis and Underworld","description":"CITCOM is a geodynamics modelling code based on the finite element method that is designed for planetary evolution modelling where large spatial variations and strong non-linearities occur in the material properties.","date":"2024-01-16","thumbnail":"/banner-8f91b8b7cc85d3974ad01c3a8d4e7336.jpg","thumbnailOptimized":"","banner":"/banner-8f91b8b7cc85d3974ad01c3a8d4e7336.jpg","bannerOptimized":"","tags":[],"level":3},{"level":2,"title":"2023"},{"slug":"compressible-convection-in-cartesian-coordinates-in-underworld3","title":"Compressible convection in cartesian coordinates with Underworld3","description":"","date":"2023-10-04","thumbnail":"/banner-3f1fc61f55a03d07a5ec01f326f6349c.jpg","thumbnailOptimized":"","banner":"/banner-3f1fc61f55a03d07a5ec01f326f6349c.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"ismip-hom-benchmark-experiments-using-underworld","title":"ISMIP-HOM benchmark experiments using Underworld","description":"","date":"2023-02-20","thumbnail":"/banner-25b0f244e632f58a01e7e1c7d5f1725d.png","thumbnailOptimized":"","banner":"/banner-25b0f244e632f58a01e7e1c7d5f1725d.png","bannerOptimized":"","tags":[],"level":3},{"level":2,"title":"2021"},{"slug":"free-surface-in-underworld","title":"Free surface in Underworld","description":"","date":"2021-12-03","thumbnail":"/banner-49c5aa1dff2953627eefc300ffa33843.jpg","thumbnailOptimized":"","banner":"/banner-49c5aa1dff2953627eefc300ffa33843.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"2-11-scaling","title":"Underworld 2.11 Scaling","description":"","date":"2021-09-30","thumbnail":"/banner-4d4dc4258d1207c19fbb8e9507e3e45a.jpg","thumbnailOptimized":"","banner":"/banner-4d4dc4258d1207c19fbb8e9507e3e45a.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"scaling-in-underworld","title":"Scaling in Underworld","description":"To test scalability we run weak scaling tests on various HPC machines to check the numerical framework remains robust when pushing for higher fidelity models.","date":"2021-03-09","thumbnail":"/banner-67f13b201f344b7e274488593d5cb52a.jpg","thumbnailOptimized":"","banner":"/banner-67f13b201f344b7e274488593d5cb52a.jpg","bannerOptimized":"","tags":[],"level":3},{"slug":"stress-recovery-in-underworld","title":"Stress recovery in Underworld","description":"","date":"2021-01-11","thumbnail":"/banner-34b6181414a3bef66b1c636afeb4e780.jpg","thumbnailOptimized":"","banner":"/banner-34b6181414a3bef66b1c636afeb4e780.jpg","bannerOptimized":"","tags":[],"level":3},{"level":2,"title":"2020"},{"slug":"underworld-low-fat-cloud","title":"Underworld's  lightweight cloud for online classrooms.","description":"We built a cheap-and-cheerful solution with persistent storage and a binder-like access to notebooks in a repository that is aimed at serving a single classroom. The zero-to-server time is just a few minutes and there is minimal manual configuration.","date":"2020-04-06","thumbnail":"/banner-da9fce6a10c00b8b8cb3487c395ad18b.png","thumbnailOptimized":"","banner":"/banner-da9fce6a10c00b8b8cb3487c395ad18b.png","bannerOptimized":"","tags":[],"level":3},{"level":2,"title":"2019"},{"slug":"viscoelasticity","title":"Viscoelasticity in Underworld2","description":"","date":"2019-08-12","thumbnail":"/banner-2460e7bf7507ba458375ddb0da1b6b36.png","thumbnailOptimized":"","banner":"/banner-2460e7bf7507ba458375ddb0da1b6b36.png","bannerOptimized":"","tags":[],"level":3},{"level":2,"title":"2018"},{"slug":"alaska-moho-model-reproducible-research-with-containers","title":"Alaska Moho Model (Reproducible research with containers)","description":"","date":"