ldren":[{"type":"link","url":"/ai-and-scientific-software-what-we-learned-rebuilding-underworld3/","children":[{"type":"text","value":"AI and Scientific Software: What We Learned Rebuilding Underworld3","key":"Z7JXShQjBO"}],"urlSource":"/ai-and-scientific-software-what-we-learned-rebuilding-underworld3/","key":"cZG45i6GrS"}],"identifier":"ai-and-scientific-software-what-we-learned-rebuilding-underworld3","label":"AI and Scientific Software: What We Learned Rebuilding Underworld3","html_id":"ai-and-scientific-software-what-we-learned-rebuilding-underworld3","implicit":true,"key":"XJ9RgZpuK5"},{"type":"div","class":"uwtn-entry-summary","children":[{"type":"text","value":"Underworld3 has about 50,000 lines of Python/ Cython wrapping PETSc, SymPy, and a just-in-time compiler. I began a trial of AI coding tools in 2025 and they have gradually become central to the way our team works. This is a story of co-evolution as much as it is about adoption of a new set of tools.","key":"P8CDWBR11k"}],"key":"PS78yxS70z"}],"key":"VNJv4fGczq"}],"key":"bwNlP4y8af"},{"type":"div","class":"uwtn-entry","children":[{"type":"div","class":"uwtn-entry-text","children":[{"type":"heading","depth":2,"children":[{"type":"link","url":"/alaska-moho-model-reproducible-research-with-containers/","children":[{"type":"text","value":"Alaska Moho Model (Reproducible research with containers)","key":"N6msGLT9x2"}],"urlSource":"/alaska-moho-model-reproducible-research-with-containers/","key":"nVFGlN17lt"}],"identifier":"alaska-moho-model-reproducible-research-with-containers","label":"Alaska Moho Model (Reproducible research with containers)","html_id":"alaska-moho-model-reproducible-research-with-containers","implicit":true,"key":"ZY4om7dW7q"},{"type":"div","class":"uwtn-entry-summary","children":[],"key":"w3Lft23bFo"}],"key":"v3M7UvOwai"}],"key":"MMEgUj33cV"},{"type":"div","class":"uwtn-entry","children":[{"type":"div","class":"uwtn-entry-text","children":[{"type":"heading","depth":2,"children":[{"type"