":"Installing packages","html_id":"installing-packages","implicit":true,"key":"d21iVIm07a"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"All our packages are built against dependencies available from the conda-forge and/or the geo-down-under conda channel.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"f0rAv4Wjrc"},{"type":"break","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"g4wyzZ4azL"},{"type":"text","value":"They need to be added to your list of channels:","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"VZGt39Bue3"}],"key":"q8U7Mti28C"},{"type":"code","lang":"bash","value":"conda config --add channels conda-forge\nconda config --append channels geo-down-under","position":{"start":{"line":86,"column":1},"end":{"line":89,"column":1}},"key":"JQbv8EEdVF"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"The first command adds the channel ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"mH5kyYVYxt"},{"type":"inlineCode","value":"conda-forge","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"cvYnssuVgh"},{"type":"text","value":" to the top of the channel list, making it the highest priority.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"tDzWCumuTE"},{"type":"break","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"YS4jy6K0dm"},{"type":"text","value":"The second command appends the channel ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"a3XRArVSNv"},{"type":"inlineCode","value":"geo-down-under","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"mM8tQ7qHas"},{"type":"text","value":" to the channel list making it the lowest 