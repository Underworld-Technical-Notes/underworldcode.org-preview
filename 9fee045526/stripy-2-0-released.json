":"figures/seafloor-age-topo.png"}],"enumerator":"1","key":"GT8Y4PIaK1"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"We’ve been busy creating the next major release of ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"vLHmu8vZWf"},{"type":"link","url":"https://github.com/underworldcode/stripy","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Stripy","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"vC23Dslhi8"}],"urlSource":"https://github.com/underworldcode/stripy","error":true,"key":"bm9RTdAcw8"},{"type":"text","value":". To refresh your memory, Stripy is a Python tool for triangulating scattered points either in Cartesian coordinates or on the sphere. It wraps a bunch of Fortran codes in a neat, object-oriented Python interface that can be used for many geographical applications.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"rEzuSs6CN7"}],"key":"uX8GxGcRsK"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"What’s new?","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ZP7mrxdjfI"}],"identifier":"whats-new","label":"What’s new?","html_id":"whats-new","implicit":true,"key":"gyvFXFmR3y"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"strong","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Spline tension","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"SysDk6XplC"}],"key":"AtG4kmaGcf"},{"type":"text","value":" - a lot of data transformations in Stripy are underpinned by cubic splines (e.g. interpolation, derivatives, smoothing). In v2.0 you can now add spline tension which avoids overshoot / undershoot artefacts. The most visible improvements are in accuracy of derivatives at points along the boundary and extrapolation of data beyond the boundary of a mesh.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"fj5uO1vcLX"}],"key":"Vt6RpDvUSW"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/9fee045526/build/spline_tension-26313ceb756eaf62d993ca5459e41f11.png","alt":"Difference between derivatives evaluated at the poles with spline tension vs. without. Looks like a beautiful flower. (Graphic generated with LavaVu).","data":{"altTextIsAutoGenerated":true},"key":"lV7VzPWhY7","urlSource":"figures/spline_tension.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Difference between derivatives evaluated at the poles with spline tension vs. without. Looks like a beautiful flower. (Graphic generated with LavaVu).","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"v6AzSRQBG3"}],"key":"rRa0N3N4en"}],"key":"a9qzIMKkwb"}],"enumerator":"2","key":"wJQX7Mf3XH"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"strong","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Voronoi diagram","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"ETyKVBZaTj"}],"key":"YzWMA74S01"},{"type":"text","value":" - the Voronoi diagram is the dual of a Delaunay triangulation. For every triangle in the mesh, there is a voronoi point which lies at an equal radius from each node. The diagram is constructed by connecting up the voronoi points from each neighbouring triangle.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"e7jbJw7310"}],"key":"IIRwgzu4Sb"},{"ty