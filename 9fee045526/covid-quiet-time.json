rworldcode.org-preview/9fee045526/build/covid-quiet-time-bed5cdee2e8002d2b9faf6bbce82c1fb.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"div","class":"uwtn-banner","children":[{"type":"image","url":"/underworldcode.org-preview/9fee045526/build/banner-6391673a14a2d81e9f447ae669e865ec.png","key":"dOYJrMxDSR","urlSource":"figures/banner.png"}],"key":"SbXtlVxhsr"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"link","url":"http://rses.anu.edu.au/people/academics/associate-professor-meghan-s-miller#acton-tabs-link--tabs-person_tabs-middle-2","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Meghan S Miller","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"xzHyixgRey"}],"urlSource":"http://rses.anu.edu.au/people/academics/associate-professor-meghan-s-miller#acton-tabs-link--tabs-person_tabs-middle-2","key":"nPflMHTAQH"},{"type":"text","value":", Louis Moresi, Research School of Earth Sciences, Australian National University","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"QUcN9COvaa"}],"key":"JZqhznto2j"}],"key":"srcnDnmTtk"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"strong","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"A ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"TNtdZPuo0y"},{"type":"link","url":"https://science.sciencemag.org/content/early/2020/07/22/science.abd2438","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"new study by an international team of scientists","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"K5ABrTYk8N"}],"urlSource":"https://science.sciencemag.org/content/early/2020/07/22/science.abd2438","key":"JCxLwzGeCs"},{"type":"text","value":" has found lockdown measures to stop the spread of COVID-19 led to a 50 per cent reduction in seismic noise observed around the world.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"Yr4l83VY8q"}],"key":"K4DbYjBWgp"},{"type":"text","value":" It is the largest reduction in human-generated noise ever observed globally.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"DeTrroZcgJ"}],"key":"cZwUkooY8p"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"The researchers, including Associate Professor Meghan Miller and Professor Louis Moresi from The Australian National University (ANU), analysed datasets from over 300 seismic stations around the world.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"j5UjYU99Y7"}],"key":"TsA6Ei483F"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"These stations use seismometers to record vibrations travelling through the ground – known as seismic waves. The study showed a reduction in seismic noise in many countries, making it possible to visualise the resulting change in human mobility – first in China, then to Italy and the rest of the world as different countries and regions implemented lockdown measures.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"w0WEA1bIt3"}],"key":"idTfYGxilr"},{"type":"thematicBreak","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"VlNdX5SYg0"},{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Diagram — see the seismic noise signal change through time across Australia","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"Uyf2z1M5Vg"}],"identifier":"diagram-see-the-seismic-noise-signal-change-through-time-across-australia","label":"Diagram — see the seismic noise signal change through time across Australia","html_id":"diagram-see-the-seismic-noise-signal-change-through-time-across-australia","implicit":true,"key":"a0DV9jkQUV"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/underworldcode.org-preview/9fee045526/build/CombinedSearchAndNoi-c2dfd364c301b594035958b3da128efd.png","alt":"In the top panel of this diagram you can see community activity such as the stock market index, google location data and COVID-19 related searches. The three panels below that one are the measure of intensity of seismic noise recorded at schools in Victoria, New South Wales and Queensland. From Christmas to January, the school holidays are very quiet at most schools and so are the shorter breaks between terms in April and July. When lockdowns occur, the schools are quiet again even though some lessons continue for children of essential workers. In July, Victoria locked down during the school holiday period while in New South Wales and Queensland students returned as normal and the differences in the diagram are obvious. The school in Ulladulla, NSW was hit by strong storms with large ocean swells striking the coast nearby and the quiet time of the holidays lets that signal shine through.","data":{"altTextIsAutoGenerated":true},"key":"Nanty8rs8M","urlSource":"figures/CombinedSearchAndNoise.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"In the top panel of this diagram you can see community activity such as the stock market index, google location data and COVID-19 related searches. The three panels below that one are the measure of intensity of seismic noise recorded at schools in Victoria, New South Wales and Queensland. From Christmas to January, the school holidays are very quiet at most schools and so are the shorter breaks between terms in April and July. When lockdowns occur, the schools are quiet again even though some lessons continue for children of essential workers. In July, Victoria locked down during the school holiday period while in New South Wales and Queensland students returned as normal and the differences in the diagram are obvious. The school in Ulladulla, NSW was hit by strong storms with large ocean swells striking the coast nearby and the quiet time of the holidays lets that signal shine through.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"KuOMaIGsR2"}],"key":"FtAx8r26wO"}],"key":"XNbZbeg1yu"}],"enumerator":"1","key":"j58C3l35Om"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Data provided by ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"PHAUCkRN2U"},{"type":"link","url":"https://www.google.com/covid19/mobility/","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"google mobility","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"pJME0JzQcn"}],"urlSource":"https://www.google.com/covid19/mobility/","key":"sSugmCCKnv"},{"type":"text","value":", google trends, ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"ts4sLAWT7p"},{"type":"link","url":"https://au.finance.yahoo.com/","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"yahoo finance (Australia)","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"cutMm5296t"}],"urlSource":"https://au.finance.yahoo.com/","key":"TJM0yzIofK"},{"type":"text","value":", and ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"MdG57WEChB"},{"type":"link","url":"https://www.auscope.org.au/geophysical-observatory","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Australian Seismometers in schools","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"ZFnfK7jbuh"}],"urlSource":"https://www.auscope.org.au/geophysical-observatory","key":"s9wUfww82V"},{"type":"text","value":". ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"Y0sSzdfhp3"},{"type":"link","url":"/articles/self-updating-repositories/","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Updated noise charts are available each day","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"Pzn73BbO9x"}],"urlSource":"/articles/self-updating-repositories/","key":"jqKE48YGWn"},{"type":"text","value":" thanks to ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"AAj45UoTKB"},{"type":"link","url":"https://github.com/","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"GitHub","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"YkUl1UxmIZ"}],"urlSource":"https://github.com/","error":true,"key":"kZFebLWXMo"},{"type":"text","value":".","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"IWetkLO6bP"}],"key":"NSNqRhV9c4"}],"key":"RHTkOwHBcP"},{"type":"thematicBreak","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"ZQmWRzKzks"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"The drop in the ‘buzz’ caused by human activity is unprecedented. This is the longest and most prominent global seismic noise reduction of this kind on record. We can see the total effect of social distancing measures, reduced economic and industrial activity and drops in tourism and travel.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"h6EI6GxYD9"}],"key":"jEfmVyyXlv"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"(A/Prof Meghan Miller)","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"wzDYfWHc73"}],"key":"msG3oSVRng"}],"key":"FKHDtEcuTv"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Dr Miller says traditionally seismometers focus on measuring seismic waves generated by  earthquakes, seismic records also contain high-frequency vibrations, or ‘buzz’, from human  movement and other natural phenomena like major storms.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"bTucONHyoq"}],"key":"GBS4qHTyza"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Walking around, driving cars, getting the train, construction work – all these things create unique seismic signatures.Perhaps unsurprisingly, the strongest seismic noise reductions were found in urban areas. But, we also saw signatures of the lockdown on sensors buried hundreds of metres below the ground and in more remote areas such as Sub-Saharan Africa.There has been much discussion about the environmental effects of the pandemic lockdown, but this is the first global study of the impact it’s had on the solid Earth beneath our feet.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"ALCekvjBNy"}],"key":"u07FOO11XU"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"(A/Prof Meghan Miller)","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"FyVPCd7eiG"}],"key":"FS9U8juoI2"}],"key":"Tr5pIwkgoQ"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"The researchers also found evidence that previously concealed earthquakes signals, especially during the daytime, appeared much clearer in urban areas during the lockdown – paving the way for the discovery of previously hidden signals from earthquakes and volcanoes.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"mMqhKYTgNW"}],"key":"k8WuxUBC3d"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"The study was the result of a unique collaboration involving 76 authors from 66 institutions in 27 countries. The findings have been published in the journal Science [","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"XnDZyOruc6"},{"type":"link","url":"https://science.sciencemag.org/content/early/2020/07/22/science.abd2438","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"LINK","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"rkUKiRljmX"}],"urlSource":"https://science.sciencemag.org/content/early/2020/07/22/science.abd2438","key":"nOOwUpHDY4"},{"type":"text","value":"]","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"rKt8o69vi2"}],"key":"USXOeauPJr"},{"type":"heading","depth":2,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"Related","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"iIEOkxzOVZ"}],"identifier":"related","label":"Related","html_id":"related","implicit":true,"key":"iOZouZVeVi"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":58,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":58,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"link","url":"/articles/australian-cities-are-quiet-during-lockdown-earthquake-scientists-are-making-the-most-of-it/","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Australian cities are quiet during lockdown. Earthquake scientists are making the most of it","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"cYTXQeb3qW"}],"urlSource":"/articles/australian-cities-are-quiet-during-lockdown-earthquake-scientists-are-making-the-most-of-it/","key":"u2MCfx7e5j"}],"key":"OOv3tz4kEj"}],"key":"ix1PobPcdi"},{"type":"listItem","spread":true,"position":{"start":{"line":60,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"link","url":"/articles/self-updating-repositories/","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Australian Seismometers in Schools - Noise monitoring dashboard","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"fT6IuvcV9j"}],"urlSource":"/articles/self-updating-repositories/","key":"CcJs4QmIAO"},{"type":"text","value":"Australian Seismometers in Schools - Noise monitoring dashboard","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"nOeuFP2721"}],"key":"mkbYFr424y"}],"key":"fZXXjar1Zp"}],"key":"dLd1lv0Ink"},{"type":"div"